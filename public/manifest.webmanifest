{
  "id": "/capture/",
  "name": "Q's Notes",
  "short_name": "Q's Notes",
  "description": "Capture thoughts, answer the week's questions, publish posts — two minutes from anywhere.",
  "start_url": "/capture/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f3ee",
  "theme_color": "#f4f3ee",
  "icons": [
    { "src": "/icons/capture-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/capture-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/capture-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Capture a thought", "url": "/capture/" },
    { "name": "Today", "url": "/flow/" },
    { "name": "Answer questions", "url": "/interview/" },
    { "name": "Publish drafts", "url": "/desk/" }
  ],
  "share_target": {
    "action": "/capture/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
