---
// Collected, numbered bibliography for a post. Backed by the optional
// `sources` frontmatter array; the prose keeps its own inline links.
interface Props {
  sources: { label: string; title: string; url?: string }[];
  lang?: 'en' | 'zh';
}
const { sources, lang = 'en' } = Astro.props;
const heading = lang === 'zh' ? '来源' : 'Sources';
---

{sources.length > 0 && (
  <div style="margin-top:8px">
    <div style="font:600 10px/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--faint);margin-bottom:11px">
      {heading}
    </div>
    <div style="display:flex;flex-direction:column;gap:8px">
      {sources.map((s, i) => (
        <div style="display:flex;gap:10px;font:500 12px/1.4 var(--mono);color:var(--muted)">
          <span style="color:var(--accent)">{i + 1}</span>
          <span>
            {s.url ? (
              <a href={s.url} target="_blank" rel="noopener" style="color:var(--body)">{s.label}</a>
            ) : (
              <span style="color:var(--body)">{s.label}</span>
            )}
            {' — '}{s.title}
          </span>
        </div>
      ))}
    </div>
  </div>
)}
