---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  modifiedDate?: Date;
  author?: string;
  lang?: 'en' | 'zh';
  /** Sibling-language URL for this page. Defaults to the other language's home. */
  langAlt?: string;
}

const {
  title,
  description = 'Small notes, essays, and opinions on AI, technology, and the work that survives them.',
  image = '/og-image.png',
  type = 'website',
  publishedDate,
  modifiedDate,
  author = 'Q',
  lang = 'en',
  langAlt,
} = Astro.props;

const homeHref = lang === 'zh' ? '/zh/' : '/';
const journalHref = lang === 'zh' ? '/zh/journal' : '/journal';
const altHref = langAlt ?? (lang === 'zh' ? '/' : '/zh/');

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/zh' || pathname === '/';
const isJournal = pathname.endsWith('/journal');
const isAbout = pathname === '/about';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image.startsWith('/') ? new URL(image, Astro.site) : image;
const siteName = "Q's Notes";

const nav =
  lang === 'zh'
    ? { home: '首页', journal: '文章', about: '关于', search: '搜索' }
    : { home: 'Home', journal: 'Journal', about: 'About', search: 'Search' };

const footerTagline =
  lang === 'zh'
    ? { a: 'Q 的笔记 —— 个人双语笔记本。', b: '在养，不在发。' }
    : { a: "Q's Notes — a personal, bilingual notebook.", b: 'Tended, not published.' };

const jsonLDWebsite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: Astro.site?.toString(),
  description: description,
};

const jsonLDArticle = publishedDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      image: ogImageURL.toString(),
      author: { '@type': 'Person', name: author },
      publisher: {
        '@type': 'Organization',
        name: siteName,
        logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
      },
      datePublished: publishedDate.toISOString(),
      dateModified: modifiedDate ? modifiedDate.toISOString() : publishedDate.toISOString(),
      mainEntityOfPage: canonicalURL.toString(),
    }
  : null;

const jsonLD = type === 'article' && jsonLDArticle ? jsonLDArticle : jsonLDWebsite;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest-blog.webmanifest" />
    <title>{title} | Q's Notes</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="preload" href="/fonts/Newsreader-Roman-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />

    <!-- No-flash theme: apply the saved (or system) theme before first paint. -->
    <script is:inline>
      function applyTheme() {
        if (
          localStorage.theme === 'dark' ||
          (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteName} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
  </head>
  <body>
    <header
      style="border-bottom:1px solid var(--line);background:var(--paper);position:sticky;top:0;z-index:50"
    >
      <div class="wrap site-header-row">
        <a
          href={homeHref}
          style="font-family:var(--serif);font-weight:500;font-size:clamp(18px,5vw,21px);color:var(--ink);text-decoration:none;flex:none"
          transition:animate="fade">Q's Notes</a
        >
        <nav class="site-nav">
          <!-- On phones the logo is the home link, so this one drops out to buy room. -->
          <a class="hide-mobile" data-bnav aria-current={isHome ? 'page' : undefined} href={homeHref}>{nav.home}</a>
          <a data-bnav aria-current={isJournal ? 'page' : undefined} href={journalHref}>{nav.journal}</a>
          <a class="hide-narrow" data-bnav aria-current={isAbout ? 'page' : undefined} href="/about">{nav.about}</a>
          <button type="button" class="search-open" data-search-open aria-label={nav.search}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
            <span class="hide-narrow">{nav.search}</span> <span class="hide-mobile" style="opacity:.55">⌘K</span>
          </button>
          <span class="lang-toggle">
            {lang === 'zh' ? (
              <>
                <a href={altHref} style="border:1px solid var(--line);border-right:none;color:var(--muted);border-radius:6px 0 0 6px">EN</a>
                <span style="background:var(--ink);color:var(--paper);border-radius:0 6px 6px 0">中</span>
              </>
            ) : (
              <>
                <span style="background:var(--ink);color:var(--paper);border-radius:6px 0 0 6px">EN</span>
                <a href={altHref} style="border:1px solid var(--line);border-left:none;color:var(--muted);border-radius:0 6px 6px 0">中</a>
              </>
            )}
          </span>
          <button type="button" class="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17a8.5 8.5 0 0 0 0-17z" fill="currentColor" stroke="none"></path></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="wrap" style="padding:44px var(--gutter) 70px;margin-top:24px">
      <div style="border-top:1px solid var(--line);padding-top:26px;display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;align-items:center">
        <div style="font-family:var(--serif);font-size:16px;color:var(--muted)">
          {footerTagline.a} <span style="color:var(--ink)">{footerTagline.b}</span>
        </div>
        <div style="display:flex;gap:16px;font:500 12px/1 var(--mono);color:var(--muted)">
          <a href={lang === 'zh' ? '/zh/rss.xml' : '/rss.xml'} style="color:var(--muted)">RSS</a>
          <a href={altHref} style="color:var(--muted)">{lang === 'zh' ? 'EN' : '中文'}</a>
          <a href="https://github.com/Akkkkkkki/q-notes" target="_blank" rel="noopener" style="color:var(--muted)">GitHub</a>
        </div>
      </div>
    </footer>

    <SearchModal lang={lang} />

    <script>
      // Theme toggle — flips the `.dark` class and remembers the choice.
      function initThemeToggle() {
        document.querySelectorAll('.theme-toggle').forEach((button) => {
          const el = button as HTMLElement & { _themeHandler?: () => void };
          if (el._themeHandler) el.removeEventListener('click', el._themeHandler);
          const handler = () => {
            const dark = document.documentElement.classList.toggle('dark');
            localStorage.theme = dark ? 'dark' : 'light';
          };
          el._themeHandler = handler;
          el.addEventListener('click', handler);
        });
      }
      initThemeToggle();
      document.addEventListener('astro:after-swap', initThemeToggle);
    </script>
  </body>
</html>
