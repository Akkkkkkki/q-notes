---
// Shared shell for the Companion app surfaces (Today / Capture / Answer /
// Publish). One place for: the head + fonts, the visual system, the bottom
// tab bar with badges, the "connect this device" onboarding, the server
// trouble banner, and the window.QN helpers (token, api, status, dictation,
// badge counts). Pages supply their content in the default slot and their
// logic in an inline script that uses QN. See docs/companion-vision.md.
interface Props {
  title: string;
  tab: 'today' | 'capture' | 'answer' | 'publish';
  lede?: string;
  // i18n keys resolved client-side from the shared dictionary (QN.t). The
  // English text above stays as the SSR/no-JS default; localizeStatic swaps
  // it for the reader's UI language on load.
  titleKey?: string;
  ledeKey?: string;
}
const { title, tab, lede, titleKey, ledeKey } = Astro.props;

const tabs = [
  {
    id: 'today',
    href: '/flow/',
    label: 'Today',
    labelKey: 'tab.today',
    icon: 'M3 10.5 12 3l9 7.5 M5 9.5 V20 a1 1 0 0 0 1 1 h12 a1 1 0 0 0 1 -1 V9.5 M9.5 21 v-5.5 h5 V21',
  },
  {
    id: 'capture',
    href: '/capture/',
    label: 'Capture',
    labelKey: 'tab.capture',
    icon: 'M12 3 a9 9 0 1 0 0 18 a9 9 0 1 0 0 -18 M12 8 v8 M8 12 h8',
  },
  {
    id: 'answer',
    href: '/interview/',
    label: 'Answer',
    labelKey: 'tab.answer',
    icon: 'M21 11.5 a8.5 8.5 0 0 1 -8.5 8.5 c-1.2 0 -2.35 -.24 -3.4 -.68 L4 21 l1.68 -5.1 A8.5 8.5 0 1 1 21 11.5 z',
  },
  {
    id: 'publish',
    href: '/desk/',
    label: 'Publish',
    labelKey: 'tab.publish',
    icon: 'M22 2 11 13 M22 2 l-7 20 -4 -9 -9 -4 z',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f3ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0c0e" />
    <title>{title} — Q's Notes</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/capture-180.png" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Newsreader-Roman-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- No-flash theme: apply the saved (or system) choice before first paint.
         Shares the localStorage key with the blog, so a reader's theme carries
         across the whole site. -->
    <script is:inline>
      (function () {
        try {
          if (
            localStorage.theme === 'dark' ||
            (!('theme' in localStorage) && matchMedia('(prefers-color-scheme: dark)').matches)
          ) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
    <style is:global>
      /* Self-hosted fonts, shared with the blog (src/styles/global.css). */
      @font-face {
        font-family: 'Geist';
        src: url('/fonts/Geist-Variable.woff2') format('woff2');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Geist Mono';
        src: url('/fonts/GeistMono-Variable.woff2') format('woff2');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Newsreader';
        src: url('/fonts/Newsreader-Roman-latin.woff2') format('woff2');
        font-weight: 300 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Newsreader';
        src: url('/fonts/Newsreader-Roman-latinext.woff2') format('woff2');
        font-weight: 300 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Newsreader';
        src: url('/fonts/Newsreader-Italic-latin.woff2') format('woff2');
        font-weight: 300 700;
        font-style: italic;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      /* ---- Paper & ink tokens (shared with the blog). Light default; the
         `.dark` class — toggled by the no-flash script + the header button —
         swaps to dark. Legacy names (--bg/--surface/--text/…) are kept as
         aliases so every existing component reskins with the palette. -------- */
      :root {
        --paper: #f4f3ee;
        --card: #fcfbf9;
        --card2: #ffffff;
        --ink: #141414;
        --body: #2b2a27;
        --muted: #6e6b64;
        --faint: #a5a199;
        --line: rgba(20, 20, 25, 0.12);
        --soft: rgba(20, 20, 25, 0.07);
        --accent: #0e7a5f;
        --accent-08: rgba(14, 122, 95, 0.08);
        --accent-14: rgba(14, 122, 95, 0.16);
        --amber: #b7841f;
        --amber-14: rgba(183, 132, 31, 0.14);
        --gold: #c79a3a;
        --dot: rgba(20, 20, 25, 0.05);
        --sh: 0 12px 38px rgba(0, 0, 0, 0.1);
        --red: #c0392f;
        --red-08: rgba(192, 57, 47, 0.08);

        --serif: 'Newsreader', 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', Georgia, serif;
        --sans: 'Geist', system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
        --mono: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

        /* legacy aliases → new palette */
        --bg: var(--paper);
        --surface: var(--card);
        --surface-2: var(--card2);
        --border: var(--line);
        --border-soft: var(--soft);
        --text: var(--ink);
        --dim: var(--faint);
        --green: var(--accent);
        --green-border: var(--accent-14);
        --amber-border: var(--amber-14);
        --radius: 0.85rem;
      }
      .dark {
        --paper: #0b0c0e;
        --card: #141719;
        --card2: #101315;
        --ink: #f1f1ef;
        --body: #c7c7c1;
        --muted: #7c7f84;
        --faint: #565a5f;
        --line: #262a2e;
        --soft: #1c1f22;
        --accent: #57c99a;
        --accent-08: rgba(87, 201, 154, 0.09);
        --accent-14: rgba(87, 201, 154, 0.18);
        --amber: #e0b24e;
        --amber-14: rgba(224, 178, 78, 0.16);
        --gold: #d9b24e;
        --dot: rgba(255, 255, 255, 0.05);
        --sh: 0 14px 44px rgba(0, 0, 0, 0.55);
        --red: #e5695f;
        --red-08: rgba(229, 105, 95, 0.1);
      }
      * { box-sizing: border-box; margin: 0; }
      /* The hidden attribute must always win, even over class display rules
         (.chip, .tidied, #rec, …), so JS `el.hidden = true` reliably hides. */
      [hidden] { display: none !important; }
      html { height: 100%; }
      body {
        font-family: var(--sans);
        background: var(--paper);
        color: var(--body);
        line-height: 1.5;
        max-width: 31rem;
        margin: 0 auto;
        min-height: 100%;
        padding: max(env(safe-area-inset-top), 0.9rem) 1.15rem
          calc(4.9rem + max(env(safe-area-inset-bottom), 0.5rem));
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      ::selection { background: var(--accent-14); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

      /* ---- screen header ---- */
      .screen-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        padding-bottom: 0.35rem;
      }
      .screen-head h1 {
        font-family: var(--serif);
        font-size: 1.7rem;
        font-weight: 500;
        letter-spacing: -0.01em;
        line-height: 1.08;
        color: var(--ink);
      }
      .head-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; flex: 0 0 auto; padding-top: 0.15rem; }
      .head-controls { display: flex; align-items: center; gap: 0.4rem; }
      #qn-meta { font-family: var(--mono); font-size: 0.72rem; font-weight: 500; color: var(--muted); }
      #qn-lang, .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 1.75rem;
        color: var(--ink);
        background: var(--card2);
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        line-height: 1;
      }
      #qn-lang { font-family: var(--mono); font-size: 0.72rem; font-weight: 600; padding: 0.1rem 0.5rem; }
      .theme-toggle { width: 1.95rem; padding: 0; }
      #qn-status { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); text-align: right; min-height: 0.9rem; }
      .lede { font-size: 0.9rem; color: var(--muted); padding-bottom: 1rem; line-height: 1.5; }

      /* ---- bottom tab bar ---- */
      #qn-tabs {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        display: flex;
        justify-content: center;
        gap: 0.25rem;
        background: var(--card);
        border-top: 1px solid var(--line);
        padding: 0.45rem max(env(safe-area-inset-left), 0.5rem)
          max(env(safe-area-inset-bottom), 0.55rem)
          max(env(safe-area-inset-right), 0.5rem);
      }
      #qn-tabs a {
        position: relative;
        flex: 1;
        max-width: 7rem;
        min-height: 3.1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.63rem;
        font-weight: 500;
        border-radius: 0.6rem;
      }
      #qn-tabs a.here { color: var(--accent); }
      #qn-tabs svg { width: 1.4rem; height: 1.4rem; }
      #qn-tabs .badge {
        position: absolute;
        top: 0.15rem;
        left: calc(50% + 0.35rem);
        min-width: 1.05rem;
        height: 1.05rem;
        padding: 0 0.28rem;
        border-radius: 999px;
        background: var(--red);
        color: #fff;
        font-family: var(--mono);
        font-size: 0.62rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      #qn-tabs .badge[hidden] { display: none; }

      /* ---- shared building blocks ---- */
      .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 0.85rem;
        padding: 0.95rem;
        margin-bottom: 0.75rem;
        font-size: 0.92rem;
        color: var(--body);
        overflow-wrap: anywhere;
      }
      .card.dim { color: var(--muted); }
      .card.dim .title { color: var(--muted); }
      button { font: inherit; cursor: pointer; }
      button:disabled { opacity: 0.5; }
      /* Primary "go" action — the accent fill. */
      .btn-primary {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--paper);
        background: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 0.7rem;
        padding: 0.75rem 1.1rem;
        min-height: 2.85rem;
      }
      /* Ink fill — the read/commit action (Read it, Save thought). */
      .btn-ink {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--paper);
        background: var(--ink);
        border: 1px solid var(--ink);
        border-radius: 0.7rem;
        padding: 0.8rem 1.1rem;
        min-height: 2.85rem;
      }
      /* Soft accent — a low-commitment primary (Ready to draft). */
      .btn-soft {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--accent);
        background: var(--accent-08);
        border: 1px solid var(--accent-14);
        border-radius: 0.7rem;
        padding: 0.8rem 1.1rem;
        min-height: 2.85rem;
      }
      .btn-primary.saved, .btn-ink.saved { background: var(--accent); border-color: var(--accent); color: var(--paper); opacity: 1; }
      .btn-ghost {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--body);
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 0.7rem;
        padding: 0.75rem 1rem;
        min-height: 2.85rem;
      }
      .btn-danger { color: var(--red); border-color: var(--line); }
      .btn-block { display: block; width: 100%; }
      textarea, input[type='text'], input[type='password'], input:not([type]) {
        width: 100%;
        font: inherit;
        font-size: 0.95rem;
        color: var(--ink);
        background: var(--card2);
        border: 1px solid var(--line);
        border-radius: 0.7rem;
        padding: 0.7rem 0.8rem;
        outline: none;
      }
      textarea::placeholder, input::placeholder { color: var(--faint); }
      textarea:focus, input:focus { border-color: var(--accent); }
      textarea { resize: vertical; }
      .chip {
        display: inline-block;
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 500;
        color: var(--muted);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.12rem 0.5rem;
        margin-right: 0.35rem;
        vertical-align: 0.08em;
      }
      .chip.warn { color: var(--amber); border-color: var(--amber-14); }
      .chip.ok { color: var(--accent); border-color: var(--accent-14); }
      .stage { margin-bottom: 1.4rem; }
      .stage > h2 {
        font-family: var(--mono);
        font-size: 0.66rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
        margin-bottom: 0.6rem;
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }
      .stage > h2 .count {
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0 0.5rem;
        font-weight: 500;
        letter-spacing: 0;
        text-transform: none;
      }
      .stage > h2 .when {
        font-weight: 400;
        letter-spacing: 0;
        text-transform: none;
        color: var(--dim);
        margin-left: auto;
        text-align: right;
      }

      /* ---- collapsible stage (standing context, opened on tap) ---- */
      .stage-fold {
        border-top: 1px solid var(--border-soft);
        padding: 0.15rem 0;
      }
      .stage-fold > summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        min-height: 2.6rem;
        font-family: var(--mono);
        font-size: 0.66rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
      }
      .stage-fold > summary::-webkit-details-marker { display: none; }
      .stage-fold > summary .count {
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0 0.5rem;
        font-weight: 500;
        letter-spacing: 0;
        text-transform: none;
      }
      .stage-fold > summary .when {
        font-weight: 400;
        letter-spacing: 0;
        text-transform: none;
        color: var(--dim);
        margin-left: auto;
        text-align: right;
      }
      .stage-fold > summary::after {
        content: '';
        flex: 0 0 auto;
        width: 0.5rem;
        height: 0.5rem;
        margin-left: 0.15rem;
        align-self: center;
        border-right: 1.5px solid var(--dim);
        border-bottom: 1.5px solid var(--dim);
        transform: rotate(45deg);
        transition: transform 0.15s ease;
      }
      .stage-fold[open] > summary::after { transform: rotate(-135deg); }
      .stage-fold .fold-body { padding: 0.15rem 0 0.75rem; }

      .sub { font-size: 0.8rem; color: var(--muted); margin-top: 0.2rem; }
      .state { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
      .fine { font-family: var(--mono); font-size: 0.7rem; color: var(--faint); }
      .hint { padding-top: 1.4rem; font-family: var(--mono); font-size: 0.7rem; color: var(--faint); text-align: center; line-height: 1.7; }
      .mic-btn, .lang-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.6rem;
        height: 2.6rem;
        padding: 0;
        font-size: 1.05rem;
        line-height: 1;
        color: var(--accent);
        background: var(--accent-08);
        border: 1px solid var(--accent-14);
        border-radius: 999px;
      }
      .lang-btn { font-family: var(--mono); font-size: 0.78rem; font-weight: 600; }
      .mic-btn.on {
        color: #fff;
        background: var(--red);
        border-color: var(--red);
        animation: qn-pulse 1.2s ease-in-out infinite;
      }
      @keyframes qn-pulse { 50% { box-shadow: 0 0 0 0.4rem rgba(192, 57, 47, 0.22); } }

      /* ---- server trouble banner ---- */
      #qn-config {
        background: var(--red-08);
        border: 1px solid var(--red);
        border-radius: var(--radius);
        padding: 0.85rem 0.95rem;
        font-size: 0.88rem;
        color: var(--body);
        margin-bottom: 1rem;
      }
      #qn-config strong { color: var(--red); }
      #qn-config a { color: var(--red); }
      #qn-config code { font-family: var(--mono); font-size: 0.8rem; }
      #qn-config details { margin-top: 0.5rem; }
      #qn-config summary { cursor: pointer; font-size: 0.8rem; color: var(--muted); }
      #qn-config .ops { display: block; margin-top: 0.45rem; font-size: 0.78rem; color: var(--muted); }

      /* ---- connect this device ---- */
      #qn-connect {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1rem;
        margin: 1rem 0;
      }
      #qn-connect h2 { font-family: var(--serif); font-size: 1.2rem; font-weight: 500; color: var(--ink); margin-bottom: 0.35rem; }
      #qn-connect p { font-size: 0.88rem; color: var(--body); margin-bottom: 0.7rem; }
      #qn-connect .row { display: flex; gap: 0.5rem; }
      #qn-connect .row input { flex: 1; min-width: 0; }
      #qn-connect .fine { margin-top: 0.6rem; }
      #qn-connect .fine code { font-family: ui-monospace, monospace; font-size: 0.7rem; }
    </style>
    <script is:inline>
      // Shared Companion helpers. Defined in <head>-order before any page
      // script; functions that touch the DOM run at call time, when the shell
      // elements above the page slot already exist.
      window.QN = (() => {
        const TOKEN_KEY = 'qn-capture-token';
        const LANG_KEY = 'qn-capture-lang';
        const UI_LANG_KEY = 'qn-ui-lang';
        const FLOW_KEY = 'qn-flow-cache';
        const FLOW_TTL = 5 * 60 * 1000;

        // ---- UI language (en / zh) ----
        // Separate from the dictation language (LANG_KEY): this governs the app
        // chrome. Defaults to the browser preference, then remembers the reader's
        // choice. Page scripts call t(...) at render time, so a toggle just sets
        // the pref and reloads — every string is re-resolved from the dictionary.
        const getUiLang = () => {
          const v = localStorage.getItem(UI_LANG_KEY);
          if (v === 'en' || v === 'zh') return v;
          return (navigator.language || 'en').toLowerCase().startsWith('zh') ? 'zh' : 'en';
        };
        const setUiLang = (l) => { localStorage.setItem(UI_LANG_KEY, l); };

        const I18N = {
          en: {
            'tab.today': 'Today', 'tab.capture': 'Capture', 'tab.answer': 'Answer', 'tab.publish': 'Publish',
            'shell.configTitle': 'The notebook server needs attention',
            'shell.configBody': ' — nothing can load or save right now. Anything you capture stays safe on this phone and syncs once it’s fixed.',
            'shell.configSummary': 'How to fix it (2 minutes, on a computer)',
            'shell.configDetail': 'The Worker lost its secrets. Re-add them on Cloudflare as type <em>Secret</em> (<code>npx wrangler secret put …</code>) — see <a href="https://github.com/Akkkkkkki/q-notes/blob/main/docs/ops-runbook.md" target="_blank" rel="noopener">the runbook</a>.',
            'shell.configMissing': 'The Worker is missing {names}. Re-pasting your key on this phone cannot fix it — re-add {pron} on Cloudflare as type <em>Secret</em> (<code>npx wrangler secret put …</code>), see <a href="https://github.com/Akkkkkkki/q-notes/blob/main/docs/ops-runbook.md" target="_blank" rel="noopener">the runbook</a>.',
            'shell.and': 'and', 'shell.pronThem': 'them', 'shell.pronIt': 'it',
            'shell.connectTitle': 'Connect this phone',
            'shell.connectBody': 'Paste your access key once. It’s stored only on this device and unlocks loading and saving on every screen.',
            'shell.connectPlaceholder': 'Access key',
            'shell.connectBtn': 'Connect',
            'shell.connectFine': 'The key is the Worker’s <code>CAPTURE_TOKEN</code> secret. Lost it? Set a fresh one with <code>npx wrangler secret put CAPTURE_TOKEN</code> and paste it here.',
            'shell.notConnected': 'not connected',
            'shell.micLabel': 'Dictate', 'shell.dictLangLabel': 'Dictation language',

            'capture.title': 'Capture', 'capture.lede': 'Type or talk. Half-formed is fine — it stays listening.',
            'capture.placeholder': 'e.g. “consulting outcomes are unfalsifiable” — one thought, one line.',
            'capture.save': 'Save thought', 'capture.recentTitle': 'Recent thoughts',
            'capture.hint': 'One line each · works offline · nothing is lost',
