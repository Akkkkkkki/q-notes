            'publish.publishing': '发布中…', 'publish.published': '已发布 ✓ —— 几分钟后上线。',
            'publish.connectFirst': '先在下方连接',
            'publish.markLede': '点出“我不会这么说”的句子——不用解释，编辑会改写并沉淀成规则。',
            'publish.sendMarks': '发送标记', 'publish.sendNMarks': '发送 {n} 句',
            'publish.marksRecorded': '✓ {n} 句已记录——改写和规则交给周五的编辑。',
            'publish.markFileError': '这个文件加载不了——去预览里读吧',
            'publish.changeLede': '用一句话说要改什么——周五的编辑会围绕它重写。',
            'publish.changePlaceholder': '说或打出这一处改动…',
            'publish.changeSent': '已发送 ✓ —— 周五的编辑照着改完再出结论，改完之前先别发布',
            'publish.connectToSee': '在下方连接这台手机，看看有哪些草稿在等你。',
            'publish.noDrafts': '没有草稿在等你——新的会在周四根据你的回答写出来。',
            'publish.cantLoadServer': '服务器修好前，草稿无法加载（见上方）。',
            'publish.cantLoad': '加载草稿失败：{msg}', 'publish.loading': '加载中…',
          },
        };

        function t(key, params) {
          if (!key) return '';
          const lang = getUiLang();
          let s = (I18N[lang] && I18N[lang][key]);
          if (s === undefined) s = I18N.en[key];
          if (s === undefined) return key;
          if (params) for (const k in params) s = s.split('{' + k + '}').join(params[k]);
          return s;
        }

        // Swap the static, server-rendered chrome (marked with data-i18n /
        // data-i18n-html / data-i18n-ph) into the current UI language. Runs once
        // on load; dynamic page strings come straight from t(...) at render time.
        function localizeStatic() {
          document.querySelectorAll('[data-i18n]').forEach((n) => {
            const k = n.getAttribute('data-i18n');
            if (k) n.textContent = t(k);
          });
          document.querySelectorAll('[data-i18n-html]').forEach((n) => {
            n.innerHTML = t(n.getAttribute('data-i18n-html'));
          });
          document.querySelectorAll('[data-i18n-ph]').forEach((n) => {
            n.setAttribute('placeholder', t(n.getAttribute('data-i18n-ph')));
          });
          document.documentElement.lang = getUiLang() === 'zh' ? 'zh-CN' : 'en';
          const h1 = document.querySelector('.screen-head h1');
          if (h1 && h1.textContent) document.title = h1.textContent + ' — Q’s Notes';
          const lb = document.getElementById('qn-lang');
          if (lb) lb.textContent = getUiLang() === 'zh' ? 'EN' : '中';
        }

        const $ = (id) => document.getElementById(id);
        const getToken = () => localStorage.getItem(TOKEN_KEY) || '';
        const setStatus = (msg) => { $('qn-status').textContent = msg; };
        // The persistent per-screen meta in the header corner (date, progress,
        // count) — separate from the transient status line beneath it.
        const setMeta = (msg) => { const m = $('qn-meta'); if (m) m.textContent = msg || ''; };
        // Page scripts run mid-parse, before shell elements that sit below the
        // page content exist — defer those DOM touches until the DOM is ready.
        const whenReady = (fn) => {
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
          else fn();
        };

        function needToken() {
          whenReady(() => {
            $('qn-connect').hidden = false;
            if (!$('qn-status').textContent) setStatus(t('shell.notConnected'));
          });
        }

        function showConfig(secrets) { whenReady(() => showConfigNow(secrets)); }
        function showConfigNow(secrets) {
          const missing = ['GITHUB_TOKEN', 'CAPTURE_TOKEN'].filter((k) => !(secrets || {})[k]);
          if (missing.length) {
            const names = '<code>' + missing.join('</code> ' + t('shell.and') + ' <code>') + '</code>';
            $('qn-config-detail').innerHTML = t('shell.configMissing', {
              names,
              pron: t(missing.length > 1 ? 'shell.pronThem' : 'shell.pronIt'),
            });
          }
          $('qn-config').hidden = false;
          $('qn-connect').hidden = true;
        }

        // The authority on whether the Worker still has its secrets: /api/health
        // answers before the secrets check, so it is truthful even when every
        // other endpoint is 503ing. Returns the presence map when they are
        // really gone, null when they are fine (or when it cannot be reached —
        // an unconfirmed guess must not accuse the secrets).
        async function secretsGone() {
          try {
            const res = await fetch('/api/health');
            if (!res.ok) return null;
            const h = await res.json();
            // Only an explicit, well-formed negative counts as a verdict. A
            // proxy error page or any body without the two presence booleans
            // says nothing about the secrets, and inferring "missing" from a
            // shape we don't recognise is exactly how the banner came to name
            // secrets that were sitting in Cloudflare all along.
            if (h.ok !== false || !h.secrets || typeof h.secrets !== 'object') return null;
            if (typeof h.secrets.GITHUB_TOKEN !== 'boolean') return null;
            if (typeof h.secrets.CAPTURE_TOKEN !== 'boolean') return null;
            return h.secrets;
          } catch {
            return null;
          }
        }

        async function api(path, body) {
          const res = await fetch(path, {
            method: body === undefined ? 'GET' : 'POST',
            headers: {
              Authorization: 'Bearer ' + getToken(),
              ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}),
            },
            body: body !== undefined ? JSON.stringify(body) : undefined,
          });
          if (res.status === 401) { needToken(); throw Object.assign(new Error('unauthorized'), { unauthorized: true }); }
          // 503 has two very different causes. The Worker having lost its
          // secrets is a server problem, not a key problem — that earns the red
          // banner. But an optional feature being unconfigured (web push, when
          // the VAPID keys were never set) also 503s while the rest of the app
          // is perfectly healthy; treating that as "the secrets are gone" told
          // the phone to re-add two secrets that were sitting in Cloudflare all
          // along. So confirm against /api/health before blaming the secrets,
          // and name the ones actually missing rather than guessing both.
          if (res.status === 503) {
            const data = await res.json().catch(() => ({}));
            const secrets = data.code === 'push_unconfigured' ? null : await secretsGone();
            // Either way a 503 is the server's fault and worth retrying later,
            // so callers holding unsaved work (capture) can queue it locally.
            if (secrets) {
              showConfig(secrets);
              throw Object.assign(new Error('server-config'), { serverError: true, config: true, retryable: true });
            }
            throw Object.assign(new Error(data.error || 'request failed (503)'), { serverError: true, status: 503, retryable: true });
          }
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw Object.assign(new Error(data.error || 'request failed (' + res.status + ')'), { serverError: true, status: res.status });
          }
          return res.json();
        }

        function el(tag, className, text) {
          const node = document.createElement(tag);
          if (className) node.className = className;
          if (text !== undefined) node.textContent = text;
          return node;
        }

        const localDate = () => {
          const d = new Date();
          return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        };

        // ---- dictation (Web Speech API; buttons only appear where supported,
        // so no broken control ever shows — OS keyboard dictation still works
        // everywhere as the fallback) ----
        const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
        const getDictLang = () => localStorage.getItem(LANG_KEY)
          || ((navigator.language || 'en').toLowerCase().startsWith('zh') ? 'zh-CN' : 'en-US');
        let activeRec = null;
        function attachDictation(textarea, onState) {
          if (!SR) return null;
          const rec = new SR();
          rec.continuous = true;
          rec.interimResults = true;
          let listening = false;
          let base = '';
          const mic = el('button', 'mic-btn', '🎙');
          mic.type = 'button';
          mic.setAttribute('aria-label', t('shell.micLabel'));
          const lang = el('button', 'lang-btn');
          lang.type = 'button';
          lang.setAttribute('aria-label', t('shell.dictLangLabel'));
          const renderLang = () => { lang.textContent = getDictLang().startsWith('zh') ? '中' : 'EN'; };
          renderLang();
          lang.addEventListener('click', () => {
            localStorage.setItem(LANG_KEY, getDictLang().startsWith('zh') ? 'en-US' : 'zh-CN');
            renderLang();
            if (listening) rec.stop();
          });
          rec.addEventListener('result', (e) => {
            let interim = '';
            for (let i = e.resultIndex; i < e.results.length; i++) {
              const t = e.results[i][0].transcript;
              if (e.results[i].isFinal) base = (base + ' ' + t).trim();
              else interim += t;
            }
            textarea.value = (base + ' ' + interim).trim();
          });
          const stopUi = () => {
            listening = false;
            mic.classList.remove('on');
            if (onState) onState(false);
          };
          rec.addEventListener('end', stopUi);
          rec.addEventListener('error', stopUi);
          mic.addEventListener('click', () => {
            if (listening) { rec.stop(); return; }
            if (activeRec && activeRec !== rec) { try { activeRec.stop(); } catch {} }
            base = textarea.value.trim();
            rec.lang = getDictLang();
            try {
              rec.start();
              activeRec = rec;
              listening = true;
              mic.classList.add('on');
              if (onState) onState(true);
            } catch { /* start() throws if already running — ignore */ }
          });
          return { mic, lang };
        }

        // ---- tab badges, fed by /api/flow (cached so Capture stays fast) ----
        async function flowData(force) {
          if (!getToken()) return null;
          if (!force) {
            try {
              const c = JSON.parse(sessionStorage.getItem(FLOW_KEY) || 'null');
              if (c && Date.now() - c.t < FLOW_TTL) return c.data;
            } catch { /* fall through to a fresh fetch */ }
          }
          const data = await api('/api/flow');
          try { sessionStorage.setItem(FLOW_KEY, JSON.stringify({ t: Date.now(), data })); } catch {}
          return data;
        }

        function applyBadges(flow) {
          if (!flow) return;
          const set = (tabId, n) => {
            const b = document.querySelector('#qn-tabs a[data-tab="' + tabId + '"] .badge');
            if (!b) return;
            b.textContent = n > 9 ? '9+' : String(n);
            b.hidden = !n;
          };
          set('today', flow.needsYou.filter((i) => i.urgency === 'now').length);
          // The Answer tab stays flagged until the brief is marked ready to
          // draft: show the count of unanswered questions, or a single badge
          // for the pending green light once they're all answered. Only a
          // ready (or closed) brief clears it.
          set('answer', flow.interview && !flow.interview.ready
            ? Math.max(flow.interview.total - flow.interview.answered, 1) : 0);
          set('publish', flow.desk.length);
        }

        function refreshBadges(force) {
          flowData(force).then(applyBadges).catch(() => { /* badges are decoration, never a blocker */ });
        }

        document.addEventListener('DOMContentLoaded', () => {
          localizeStatic();
          const langBtn = $('qn-lang');
          if (langBtn) langBtn.addEventListener('click', () => {
            setUiLang(getUiLang() === 'zh' ? 'en' : 'zh');
            location.reload();
          });
          // Theme toggle — flips the `.dark` class and remembers the choice in
          // the same key the blog and the no-flash script use.
          const themeBtn = $('qn-theme');
          if (themeBtn) themeBtn.addEventListener('click', () => {
            const dark = document.documentElement.classList.toggle('dark');
            try { localStorage.theme = dark ? 'dark' : 'light'; } catch (e) {}
          });
          $('qn-token-save').addEventListener('click', () => {
            const v = $('qn-token').value.trim();
            if (!v) return;
            localStorage.setItem(TOKEN_KEY, v);
            location.reload();
          });
          $('qn-token').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') $('qn-token-save').click();
          });
          if ('serviceWorker' in navigator) navigator.serviceWorker.register('/capture-sw.js');
          // Non-blocking health probe: if the Worker lost its secrets, say so
          // up front instead of letting the next action fail confusingly.
          secretsGone().then((secrets) => { if (secrets) showConfig(secrets); });
          refreshBadges(false);
        });

        return { $, getToken, setStatus, setMeta, needToken, showConfig, api, el, localDate, attachDictation, flowData, applyBadges, refreshBadges, t, getUiLang, setUiLang, localizeStatic };
      })();
    </script>
  </head>
  <body>
    <header class="screen-head">
      <h1 data-i18n={titleKey}>{title}</h1>
      <div class="head-right">
        <div class="head-controls">
          <span id="qn-meta"></span>
          <button id="qn-lang" type="button" aria-label="Switch language / 切换语言"></button>
          <button id="qn-theme" class="theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17a8.5 8.5 0 0 0 0-17z" fill="currentColor" stroke="none"></path></svg>
          </button>
        </div>
        <span id="qn-status"></span>
      </div>
    </header>
    {lede && <p class="lede" data-i18n={ledeKey}>{lede}</p>}

    <div id="qn-config" hidden>
      <strong data-i18n="shell.configTitle">The notebook server needs attention</strong>
      <span data-i18n="shell.configBody"> — nothing can load or save
      right now. Anything you capture stays safe on this phone and syncs once it's fixed.</span>
      <details>
        <summary data-i18n="shell.configSummary">How to fix it (2 minutes, on a computer)</summary>
        <span class="ops" id="qn-config-detail" data-i18n-html="shell.configDetail">The Worker lost its secrets. Re-add them on
        Cloudflare as type <em>Secret</em> (<code>npx wrangler secret put …</code>) — see
        <a href="https://github.com/Akkkkkkki/q-notes/blob/main/docs/ops-runbook.md" target="_blank" rel="noopener">the runbook</a>.</span>
      </details>
    </div>

    <slot />

    <section id="qn-connect" hidden>
      <h2 data-i18n="shell.connectTitle">Connect this phone</h2>
      <p data-i18n="shell.connectBody">Paste your access key once. It's stored only on this device and unlocks
        loading and saving on every screen.</p>
      <div class="row">
        <input id="qn-token" type="password" autocomplete="off" placeholder="Access key" data-i18n-ph="shell.connectPlaceholder" />
        <button id="qn-token-save" class="btn-primary" data-i18n="shell.connectBtn">Connect</button>
      </div>
      <p class="fine" data-i18n-html="shell.connectFine">The key is the Worker's <code>CAPTURE_TOKEN</code> secret. Lost it?
        Set a fresh one with <code>npx wrangler secret put CAPTURE_TOKEN</code> and paste
        it here.</p>
    </section>

    <nav id="qn-tabs" aria-label="App sections">
      {tabs.map((t) => (
        <a href={t.href} class={t.id === tab ? 'here' : undefined} data-tab={t.id}
          aria-current={t.id === tab ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={t.icon} />
          </svg>
          <span data-i18n={t.labelKey}>{t.label}</span>
          <span class="badge" hidden></span>
        </a>
      ))}
    </nav>
  </body>
</html>
