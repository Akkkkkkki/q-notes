---
// Capture — "thought to repo in under 15 seconds" (vision §3.1).
// Opens straight into the text box with the keyboard up; everything else
// (tabs, connect card, error banner) comes from the shared shell.
import CompanionLayout from '../layouts/CompanionLayout.astro';
---

<CompanionLayout
  title="Capture"
  titleKey="capture.title"
  tab="capture"
  lede="Catch a thought — type or talk, hit save. Half-formed is fine."
  ledeKey="capture.lede"
>
  <style is:global>
    #composer { position: relative; }
    #spark {
      min-height: 7.5rem;
      font-size: 1.05rem;
      line-height: 1.5;
      border-radius: var(--radius);
      padding: 0.85rem 0.85rem 3.6rem 0.85rem;
      resize: none;
    }
    #composer .mic-btn { position: absolute; bottom: 0.6rem; right: 0.6rem; }
    #composer .lang-btn { position: absolute; bottom: 0.6rem; right: 3.55rem; }
    #send { margin-top: 0.75rem; }
    #source {
      margin-top: 0.5rem;
      font-size: 0.78rem;
      color: var(--muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    #recent { margin-top: 1.75rem; }
    #recent ul { list-style: none; padding: 0; }
    #recent li {
      font-size: 0.88rem;
      line-height: 1.45;
      color: var(--body);
      padding: 0.5rem 0;
      border-top: 1px solid var(--border-soft);
      overflow-wrap: anywhere;
    }
    #recent li.empty { color: var(--muted); border-top: none; }
    #recent li.eg { color: var(--dim); font-style: italic; border-top: none; padding-top: 0; }
    #recent li.pending { color: var(--muted); }
  </style>

  <div id="composer">
    <textarea
      id="spark"
      autofocus
      maxlength="2000"
      enterkeyhint="send"
      placeholder="e.g. “consulting outcomes are unfalsifiable” — one thought, one line."
      data-i18n-ph="capture.placeholder"></textarea>
  </div>
  <div id="source" hidden></div>
  <button id="send" type="button" class="btn-primary btn-block" data-i18n="capture.save">Save thought</button>

  <section id="recent" class="stage" hidden>
    <h2 data-i18n="capture.recentTitle">Recent thoughts</h2>
    <ul></ul>
  </section>

  <p class="hint" data-i18n="capture.hint">One line each · works offline · nothing is lost</p>

  <script is:inline>
    const { $, api, getToken, setStatus, needToken, localDate, attachDictation, refreshBadges, t } = QN;
    const sparkEl = $('spark');
    const sendEl = $('send');
    const sourceEl = $('source');
    const recentEl = $('recent');
    const QUEUE_KEY = 'qn-spark-queue';

    // Share-target prefill (?text=&url=&title= via the manifest GET target).
    const params = new URLSearchParams(location.search);
    let sharedUrl = params.get('url') || '';
    const sharedText = [params.get('title'), params.get('text')].filter(Boolean).join(' — ');
    if (sharedText) {
      // Android often stuffs the URL into `text`; split it out as provenance.
      const m = sharedText.match(/https?:\/\/\S+$/);
      if (m && !sharedUrl) {
        sharedUrl = m[0];
        sparkEl.value = sharedText.slice(0, m.index).trim();
      } else {
        sparkEl.value = sharedText;
      }
    }
    if (sharedUrl) {
      sourceEl.textContent = '← ' + sharedUrl;
      sourceEl.hidden = false;
    }

    function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;'); }
    // One clear confirmation right on the button the thumb just pressed —
    // grey text in the header corner reads as "did anything happen?".
    let savedTimer;
    function flashSaved(label) {
      sendEl.textContent = label || t('capture.saved');
      sendEl.classList.add('saved');
      clearTimeout(savedTimer);
      savedTimer = setTimeout(() => {
        sendEl.textContent = t('capture.save');
        sendEl.classList.remove('saved');
      }, 1800);
    }
    function getQueue() { try { return JSON.parse(localStorage.getItem(QUEUE_KEY)) || []; } catch { return []; } }
    function setQueue(q) { localStorage.setItem(QUEUE_KEY, JSON.stringify(q)); }
    // Stash the thought locally and clear the box, so a failed send never loses it.
    function queueSpark(spark) {
      const q = getQueue();
      q.push(spark);
      setQueue(q);
      sparkEl.value = '';
      sharedUrl = '';
      sourceEl.hidden = true;
      loadRecent();
    }

    async function flushQueue() {
      let queue = getQueue();
      while (queue.length) {
        try {
          await api('/api/spark', queue[0]);
        } catch (e) {
          if (e.unauthorized) needToken();
          setQueue(queue);
          if (e.serverError) throw e;
          setStatus(t('capture.waitingToSync', { n: queue.length }));
          return false;
        }
        queue = queue.slice(1);
        setQueue(queue);
      }
      return true;
    }

    async function send() {
      const text = sparkEl.value.trim();
      if (!text) return;
      const spark = { text, url: sharedUrl, date: localDate() };

      sendEl.disabled = true;
      setStatus(t('capture.saving'));
      try {
        const flushed = await flushQueue();
        if (!flushed) throw new Error('offline');
        await api('/api/spark', spark);
        sparkEl.value = '';
        sharedUrl = '';
        sourceEl.hidden = true;
        flashSaved(t('capture.saved'));
        setStatus(t('capture.inInbox'));
        loadRecent();
      } catch (e) {
        if (e.unauthorized) {
          // Don't lose the thought: keep it on this phone until the key exists.
          queueSpark(spark);
          flashSaved(t('capture.savedHere'));
          setStatus(t('capture.connectToSync'));
        } else if (e.config) {
          // Queue it like an offline send. To the author it's simply "saved" —
          // the server-side fix is the banner's job.
          queueSpark(spark);
          flashSaved(t('capture.savedHere'));
          setStatus(t('capture.willSyncServer', { n: getQueue().length }));
        } else if (e.serverError && e.status >= 400 && e.status < 500) {
          // A validation failure (e.g. too long): retrying can't help, so show the
          // server's own actionable message and keep the thought in the box to edit.
          setStatus(e.message);
        } else if (e.serverError) {
          // Network / 5xx: retrying may help. Keep the thought in the box; don't
          // surface the opaque server/proxy text.
          console.error('spark send failed:', e.message);
          setStatus(t('capture.cantReach'));
        } else {
          queueSpark(spark);
          flashSaved(t('capture.saved'));
          setStatus(t('capture.willSyncOnline', { n: getQueue().length }));
        }
      } finally {
        sendEl.disabled = false;
        sparkEl.focus();
      }
    }

    async function loadRecent() {
      const ul = recentEl.querySelector('ul');
      recentEl.hidden = false;
      // Locally-queued thoughts (not yet synced) sit on top as proof the box works,
      // even before a key exists.
      const pending = getQueue().map(
        (s) => '<li class="pending">' + esc((s.date || localDate()) + ' — ' + s.text) + ' · ' + t('capture.syncing') + '</li>'
      );
      let synced = [];
      if (getToken()) {
        try {
          synced = (await api('/api/sparks')).sparks || [];
        } catch { /* reward loop only — never block capture */ }
      }
      const rows = pending.concat(synced.map((s) => '<li>' + esc(s) + '</li>')).slice(0, 3);
      ul.innerHTML = rows.length
        ? rows.join('')
        : '<li class="empty">' + esc(t('capture.recentEmpty')) + '</li>'
          + '<li class="eg">' + esc(t('capture.recentEg')) + '</li>';
    }

    // Voice-first (vision §3.1, §6): dictation buttons appear only where the
    // Web Speech API exists; OS-keyboard dictation is the fallback elsewhere.
    const dict = attachDictation(sparkEl, (on) => {
      if (on) setStatus(t('capture.listening'));
      else if ($('qn-status').textContent === t('capture.listening')) setStatus('');
    });
    if (dict) $('composer').append(dict.lang, dict.mic);

    sendEl.addEventListener('click', send);
    sparkEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) send();
    });
    window.addEventListener('online', () => {
      flushQueue().then((ok) => { if (ok && getQueue().length === 0) setStatus(''); loadRecent(); })
        .catch(() => loadRecent());
    });

    if (!getToken()) needToken();
    const pendingCount = getQueue().length;
    if (pendingCount) setStatus(t('capture.waitingToSync', { n: pendingCount }));
    flushQueue().then((ok) => { if (ok) refreshBadges(false); loadRecent(); })
      .catch(() => loadRecent());
  </script>
</CompanionLayout>
