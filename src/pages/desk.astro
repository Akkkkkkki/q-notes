---
// Publish — "ship from the couch" (vision §3.3).
// One card per draft waiting as an open content PR: a plain-language status,
// a big "read it" preview button, the voice panel (your words kept +
// keep/cut flags), and Publish / Ask for one change / Make it a note /
// Discard. Publishing offers the two author-owned slots — title and last
// line — both skippable in one tap.
import CompanionLayout from '../layouts/CompanionLayout.astro';
---

<CompanionLayout
  title="Publish"
  titleKey="publish.title"
  tab="publish"
  lede="Drafts waiting for your OK — read, then publish or let it go."
  ledeKey="publish.lede"
>
  <style is:global>
    .draft h2 { font-size: 1.02rem; font-weight: 650; letter-spacing: -0.01em; color: var(--text); }
    .meta { font-size: 0.75rem; color: var(--muted); margin: 0.3rem 0 0.6rem; }
    .status-line {
      display: flex;
      gap: 0.5rem;
      align-items: baseline;
      font-size: 0.88rem;
      font-weight: 600;
      margin-bottom: 0.55rem;
    }
    .status-line .dot { flex: 0 0 auto; width: 0.55rem; height: 0.55rem; border-radius: 999px; position: relative; top: -0.05rem; }
    .status-line.ready { color: var(--green); }
    .status-line.ready .dot { background: var(--green); }
    .status-line.attention { color: var(--amber); }
    .status-line.attention .dot { background: var(--amber); }
    .status-line.none { color: var(--muted); font-weight: 500; }
    .status-line.none .dot { background: var(--dim); }
    .verdict-details { margin-bottom: 0.7rem; }
    .verdict-details summary { cursor: pointer; font-size: 0.78rem; color: var(--muted); }
    .verdict {
      font-size: 0.85rem;
      color: var(--body);
      background: #131313;
      border: 1px solid #242424;
      border-radius: 0.5rem;
      padding: 0.6rem 0.7rem;
      margin-top: 0.45rem;
      white-space: pre-wrap;
      max-height: 14rem;
      overflow-y: auto;
    }
    .preview { margin-bottom: 0.7rem; text-align: center; text-decoration: none; }
    .voice { margin-bottom: 0.7rem; }
    .voice h3 { font-size: 0.78rem; font-weight: 600; color: var(--muted); margin-bottom: 0.3rem; }
    .voice .spine li { font-size: 0.85rem; color: var(--body); }
    .voice ul { padding-left: 1.1rem; margin-bottom: 0.4rem; }
    .flag {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      font-size: 0.85rem;
      background: #1a1612;
      border: 1px solid #3a3226;
      border-radius: 0.5rem;
      padding: 0.45rem 0.6rem;
      margin-bottom: 0.4rem;
    }
    .flag span { flex: 1; }
    .flag button {
      font-size: 0.78rem;
      font-weight: 600;
      border: 1px solid var(--border);
      border-radius: 0.4rem;
      background: transparent;
      color: var(--body);
      padding: 0.35rem 0.7rem;
      min-height: 2.1rem;
    }
    .ab { margin-bottom: 0.7rem; }
    .ab h3 { font-size: 0.78rem; font-weight: 600; color: var(--muted); margin-bottom: 0.3rem; }
    .ab .q { margin-bottom: 0.6rem; }
    .ab .q-label { font-size: 0.82rem; color: var(--body); margin-bottom: 0.3rem; }
    .ab .why-row { display: flex; gap: 0.5rem; margin-top: 0.35rem; }
    .ab .why-row input { flex: 1; min-width: 0; }
    .readmark { margin-bottom: 0.7rem; }
    .readmark .file-label { font-size: 0.75rem; color: var(--muted); margin: 0.7rem 0 0.35rem; font-family: ui-monospace, monospace; }
    .readmark p.para { font-size: 0.92rem; line-height: 1.65; color: var(--body); margin-bottom: 0.7rem; }
    .readmark p.para.heading { font-weight: 650; color: var(--text); }
    .readmark .sentence { cursor: pointer; border-radius: 0.25rem; padding: 0.08rem 0; }
    .readmark .sentence.marked {
      background: rgba(229, 72, 77, 0.18);
      color: #f0b0b3;
      text-decoration: line-through;
      text-decoration-color: rgba(229, 72, 77, 0.6);
    }
    .readmark .send-row { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem; }
    .actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.6rem; }
    .panel { border-top: 1px solid #242424; margin-top: 0.7rem; padding-top: 0.7rem; }
    .panel .panel-lede { font-size: 0.82rem; color: var(--muted); margin-bottom: 0.3rem; }
    .panel label { font-size: 0.78rem; color: var(--muted); display: block; margin: 0.5rem 0 0.25rem; }
    .panel textarea { min-height: 4rem; }
    .options button {
      display: block;
      width: 100%;
      text-align: left;
      font-size: 0.85rem;
      color: var(--body);
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      padding: 0.55rem 0.7rem;
      margin-bottom: 0.35rem;
    }
    .options button.picked { border-color: var(--text); color: var(--text); }

    /* Voice & calibration fold — collapsed by default, opens to the panels. */
    .vc-fold { border-top: 1px solid #242424; margin-bottom: 0.7rem; }
    .vc-fold > summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.6rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--muted);
    }
    .vc-fold > summary::-webkit-details-marker { display: none; }
    .vc-fold > summary .vc-count {
      min-width: 1.15rem;
      height: 1.15rem;
      padding: 0 0.3rem;
      border-radius: 999px;
      background: var(--amber);
      color: #0a0a0a;
      font-size: 0.68rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .vc-fold > summary::after {
      content: '';
      flex: 0 0 auto;
      width: 0.5rem;
      height: 0.5rem;
      margin-left: auto;
      border-right: 1.5px solid var(--dim);
      border-bottom: 1.5px solid var(--dim);
      transform: rotate(45deg);
      transition: transform 0.15s ease;
    }
    .vc-fold[open] > summary::after { transform: rotate(-135deg); }
    .vc-fold .fold-body { padding-top: 0.5rem; }
  </style>

  <main id="cards"></main>
  <p id="empty" class="card dim" hidden></p>

  <p class="hint" data-i18n="publish.hint">Goes live minutes after you publish · letting one go is valid</p>

  <script is:inline>
    const { $, api, el, getToken, setStatus, needToken, refreshBadges, t } = QN;

    function showEmpty(msg) {
      $('empty').textContent = msg;
      $('empty').hidden = false;
    }

    // Rough markdown→text for the read-aloud view; the author marks what they
    // see, and the ship gate locates the sentence in the file itself.
    function plain(md) {
      return md
        .replace(/^#{1,6}\s*/, '')
        .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
        .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
        .replace(/\*\*([^*]+)\*\*/g, '$1')
        .replace(/\*([^*]+)\*/g, '$1')
        .replace(/`([^`]+)`/g, '$1')
        .replace(/^\s*(?:[-*]|\d+[.)])\s+/gm, '');
    }

    function splitSentences(text) {
      return (text.match(/[^。！？.!?]+[。！？.!?]*["”』」)]*/g) || [text])
        .map((s) => s.trim())
        .filter(Boolean);
    }

    function statusFor(verdict) {
      if (!verdict) return { cls: 'none', label: t('publish.notCheckedStatus') };
      if (/ready to ship/i.test(verdict)) return { cls: 'ready', label: t('publish.readyStatus') };
      if (/needs your call/i.test(verdict)) return { cls: 'attention', label: t('publish.needsCallStatus') };
      return { cls: 'attention', label: t('publish.checkedStatus') };
    }

    function renderCard(pr) {
      const card = el('section', 'card draft');
      card.appendChild(el('h2', '', pr.title));

      const meta = el('p', 'meta');
      meta.appendChild(el('span', 'chip', '#' + pr.number));
      if (pr.tier) meta.appendChild(el('span', 'chip', pr.tier));
      meta.appendChild(el('span', 'chip', t('publish.waitingNd', { n: pr.ageDays })));
      card.appendChild(meta);

      const st = statusFor(pr.verdict);
      const statusLine = el('div', 'status-line ' + st.cls);
      statusLine.appendChild(el('span', 'dot'));
      statusLine.appendChild(el('span', '', st.label));
      card.appendChild(statusLine);

      if (pr.verdict) {
        const details = el('details', 'verdict-details');
        details.appendChild(el('summary', '', t('publish.whatEditorSaid')));
        details.appendChild(el('div', 'verdict', pr.verdict));
        card.appendChild(details);
      }

      const preview = el('a', 'btn-ghost btn-block preview',
        pr.previewUrl ? t('publish.readIt') : t('publish.openGithub'));
      preview.href = pr.previewUrl || pr.url;
      preview.target = '_blank';
      preview.rel = 'noopener';
      preview.title = pr.previewUrl ? t('publish.previewTitleReal') : t('publish.previewTitleGithub');
      card.appendChild(preview);

      // Voice & calibration — folded away so the card stays a decision
      // surface. Opens to the kept-words list, the keep/cut flags, and the
      // A/B questions; the summary badge counts only what still needs a tap.
      const abPending = pr.ab.questions.filter((q) => !pr.ab.answered.includes(q.n));
      if (pr.voice.spine.length || pr.voice.flags.length || abPending.length) {
        const fold = el('details', 'vc-fold');
        const summary = el('summary');
        summary.appendChild(el('span', '', t('publish.voiceCalib')));
        const pending = pr.voice.flags.length + abPending.length;
        if (pending) summary.appendChild(el('span', 'vc-count', String(pending)));
        fold.appendChild(summary);
        const foldBody = el('div', 'fold-body');
        fold.appendChild(foldBody);

        if (pr.voice.spine.length || pr.voice.flags.length) {
          const voice = el('div', 'voice');
          if (pr.voice.spine.length) {
            voice.appendChild(el('h3', '', t('publish.wordsKept')));
            const ul = el('ul', 'spine');
            for (const phrase of pr.voice.spine) ul.appendChild(el('li', '', '“' + phrase + '”'));
            voice.appendChild(ul);
          }
          for (const flag of pr.voice.flags) {
            const row = el('div', 'flag');
            row.appendChild(el('span', '', t('publish.draftSaysFlag', { flag })));
            for (const [decision, label] of [['keep', t('publish.keep')], ['cut', t('publish.cut')]]) {
              const b = el('button', '', label);
              b.addEventListener('click', async () => {
                b.disabled = true;
                try {
                  await api('/api/desk/comment', { number: pr.number, kind: 'voice', decision, text: flag });
                  row.replaceChildren(el('span', '', t('publish.flagResolved', { flag, decision: label })));
                } catch (e) { b.disabled = false; setStatus(t('publish.didntSend')); }
              });
              row.appendChild(b);
            }
            voice.appendChild(row);
          }
          foldBody.appendChild(voice);
        }

        // A/B calibration (issue #44): the drafter's 2–3 ten-second questions,
        // already-answered ones hidden. Tap an option, optionally say why, send.
        // Skipping is a valid answer — it just dismisses the question here.
        if (abPending.length) {
          const ab = el('div', 'ab');
          ab.appendChild(el('h3', '', t('publish.abHeading')));
          for (const q of abPending) {
            const wrap = el('div', 'q');
            wrap.appendChild(el('p', 'q-label', 'Q' + q.n + ' · ' + q.label));
            const opts = el('div', 'options');
            let picked = null;
            const whyRow = el('div', 'why-row');
            whyRow.hidden = true;
            const why = el('input');
            why.placeholder = t('publish.abWhyPlaceholder');
            const send = el('button', 'btn-primary', t('publish.send'));
            send.addEventListener('click', async () => {
              if (!picked) return;
              send.disabled = true;
              try {
                await api('/api/desk/comment', {
                  number: pr.number, kind: 'ab', question: q.n, choice: picked, why: why.value.trim(),
                });
                wrap.replaceChildren(el('p', 'q-label', t('publish.abRecorded', { n: q.n, picked })));
              } catch (e) { send.disabled = false; setStatus(t('publish.didntSend')); }
            });
            why.addEventListener('keydown', (e) => { if (e.key === 'Enter') send.click(); });
            whyRow.append(why, send);
            for (const option of q.options) {
              const b = el('button', '', option.letter + ' · ' + option.text);
              b.addEventListener('click', () => {
                picked = option.letter;
                whyRow.hidden = false;
                for (const sib of opts.children) sib.classList.toggle('picked', sib === b);
              });
              opts.appendChild(b);
            }
            const skip = el('button', 'btn-ghost', t('publish.skip'));
            skip.style.cssText = 'min-height:2.1rem;padding:0.3rem 0.7rem;font-size:0.78rem;';
            skip.addEventListener('click', () => wrap.remove());
            wrap.append(opts, whyRow, skip);
            ab.appendChild(wrap);
          }
          foldBody.appendChild(ab);
        }
        card.appendChild(fold);
      }

      const actions = el('div', 'actions');
      const panel = el('div', 'panel');
      panel.hidden = true;
      let openPanel = null;

      function togglePanel(name, build) {
        if (openPanel === name) { panel.hidden = true; openPanel = null; return; }
        openPanel = name;
        panel.hidden = false;
        panel.replaceChildren();
        build(panel);
      }

      const ship = el('button', 'btn-primary', t('publish.publish'));
      ship.addEventListener('click', () => togglePanel('ship', buildShipPanel));
      const oneChange = el('button', 'btn-ghost', t('publish.askChange'));
      oneChange.addEventListener('click', () => togglePanel('change', buildChangePanel));
      const readMark = el('button', 'btn-ghost', t('publish.readMark'));
      readMark.addEventListener('click', () => togglePanel('marks', buildMarkPanel));
      const downgrade = el('button', 'btn-ghost', t('publish.makeNote'));
      downgrade.addEventListener('click', async () => {
        if (!confirm(t('publish.confirmDowngrade'))) return;
        downgrade.disabled = true;
        try {
          await api('/api/desk/comment', { number: pr.number, kind: 'downgrade' });
          downgrade.textContent = t('publish.noteRequested');
        } catch (e) { downgrade.disabled = false; setStatus(t('publish.didntSend')); }
      });
      const kill = el('button', 'btn-ghost btn-danger', t('publish.discard'));
      kill.addEventListener('click', async () => {
        if (!confirm(t('publish.confirmDiscard'))) return;
        kill.disabled = true;
        try {
          await api('/api/desk/kill', { number: pr.number });
          card.remove();
          refreshBadges(true);
        } catch (e) { kill.disabled = false; setStatus(t('publish.didntWork')); }
      });
      actions.append(ship, oneChange, readMark, downgrade, kill);
      card.appendChild(actions);
      card.appendChild(panel);

      // Publish panel: the two author-owned touches, both optional —
      // "Publish now" with everything blank ships the draft exactly as-is.
      function buildShipPanel(panel) {
        panel.appendChild(el('p', 'panel-lede', t('publish.shipLede')));
        const slots = []; // one row per content file: { path, titleInput, lineInput }
        for (const entry of pr.lastLines.length ? pr.lastLines : pr.contentFiles.map((p) => ({ path: p, text: '' }))) {
          panel.appendChild(el('label', '', entry.path));

          if (pr.titleOptions.length) {
            const opts = el('div', 'options');
            panel.appendChild(opts);
            for (const option of pr.titleOptions) {
              const b = el('button', '', option);
              b.addEventListener('click', () => {
                titleInput.value = titleInput.value === option ? '' : option;
                for (const sib of opts.children) sib.classList.toggle('picked', sib === b && titleInput.value === option);
              });
              opts.appendChild(b);
            }
          }
          const titleInput = el('input');
          titleInput.placeholder = t('publish.yourTitle');
          panel.appendChild(titleInput);

          panel.appendChild(el('label', '', entry.text
            ? t('publish.lastLineCurrent', { text: entry.text.slice(0, 120) + (entry.text.length > 120 ? '…' : '') })
            : t('publish.lastLine')));
          const lineInput = el('textarea');
          lineInput.placeholder = t('publish.lastLinePlaceholder');
          panel.appendChild(lineInput);
          slots.push({ path: entry.path, titleInput, lineInput });
        }

        const go = el('button', 'btn-primary', t('publish.publishNow'));
        go.style.marginTop = '0.6rem';
        const state = el('span', 'state');
        state.style.marginLeft = '0.5rem';
        go.addEventListener('click', async () => {
          go.disabled = true;
          try {
            for (const slot of slots) {
              const title = slot.titleInput.value.trim();
              const lastLine = slot.lineInput.value.trim();
              if (!title && !lastLine) continue;
              state.textContent = t('publish.applyingTouches');
              await api('/api/desk/slots', { number: pr.number, path: slot.path, title, lastLine });
            }
            state.textContent = t('publish.publishing');
            await api('/api/desk/ship', { number: pr.number });
            card.replaceChildren(el('h2', '', pr.title), el('p', 'meta', t('publish.published')));
            refreshBadges(true);
          } catch (e) {
            go.disabled = false;
            state.textContent = e.unauthorized ? t('publish.connectFirst') : e.message;
          }
        });
        panel.append(go, state);
      }

      // Read & mark (issue #44): the draft as tappable sentences. Tap what
      // you'd never say — no explanation needed; the Friday editor rewrites
      // each marked sentence and distills the rule into the voiceprint.
      function buildMarkPanel(panel) {
        panel.appendChild(el('p', 'panel-lede', t('publish.markLede')));
        const container = el('div', 'readmark');
        panel.appendChild(container);
        // Keyed by span, not sentence text: a repeated sentence must toggle
        // per occurrence. Duplicates collapse at send time.
        const marked = new Set();
        const sendRow = el('div', 'send-row');
        const send = el('button', 'btn-primary', t('publish.sendMarks'));
        send.disabled = true;
        const state = el('span', 'state');
        sendRow.append(send, state);
        panel.appendChild(sendRow);
        const update = () => {
          send.textContent = marked.size ? t('publish.sendNMarks', { n: marked.size }) : t('publish.sendMarks');
          send.disabled = !marked.size;
        };

        (async () => {
          for (const path of pr.contentFiles.slice(0, 3)) {
            container.appendChild(el('div', 'file-label', path));
            try {
              const { paragraphs } = await api(
                '/api/desk/draft?number=' + pr.number + '&path=' + encodeURIComponent(path));
              for (const para of paragraphs) {
                const p = el('p', 'para' + (/^#{1,6}\s/.test(para) ? ' heading' : ''));
                for (const s of splitSentences(plain(para))) {
                  const span = el('span', 'sentence', s);
                  span.addEventListener('click', () => {
                    if (marked.has(span)) { marked.delete(span); span.classList.remove('marked'); }
                    else { marked.add(span); span.classList.add('marked'); }
                    update();
                  });
                  p.append(span, ' ');
                }
                container.appendChild(p);
              }
            } catch (e) {
              container.appendChild(el('p', 'para', t('publish.markFileError')));
            }
          }
        })();

        send.addEventListener('click', async () => {
          send.disabled = true;
          try {
            const marks = [...new Set([...marked].map((s) => s.textContent))];
            await api('/api/desk/comment', { number: pr.number, kind: 'marks', marks });
            panel.replaceChildren(el('span', 'state', t('publish.marksRecorded', { n: marks.length })));
          } catch (e) {
            send.disabled = false;
            state.textContent = t('publish.didntSend');
          }
        });
      }

      function buildChangePanel(panel) {
        panel.appendChild(el('p', 'panel-lede', t('publish.changeLede')));
        const ta = el('textarea');
        ta.placeholder = t('publish.changePlaceholder');
        panel.appendChild(ta);
        const send = el('button', 'btn-primary', t('publish.send'));
        send.style.marginTop = '0.6rem';
        send.addEventListener('click', async () => {
          const text = ta.value.trim();
          if (!text) return;
          send.disabled = true;
          try {
            await api('/api/desk/comment', { number: pr.number, kind: 'one-change', text });
            panel.replaceChildren(el('span', 'state', t('publish.changeSent')));
          } catch (e) { send.disabled = false; setStatus(t('publish.didntSend')); }
        });
        panel.appendChild(send);
      }

      return card;
    }

    async function load() {
      if (!getToken()) {
        needToken();
        showEmpty(t('publish.connectToSee'));
        return;
      }
      setStatus(t('publish.loading'));
      try {
        const { prs } = await api('/api/desk');
        setStatus('');
        const cards = $('cards');
        cards.replaceChildren();
        if (!prs.length) {
          showEmpty(t('publish.noDrafts'));
          return;
        }
        $('empty').hidden = true;
        for (const pr of prs) cards.appendChild(renderCard(pr));
      } catch (e) {
        if (e.unauthorized) {
          showEmpty(t('publish.connectToSee'));
        } else if (e.config) {
          showEmpty(t('publish.cantLoadServer'));
        } else {
          showEmpty(t('publish.cantLoad', { msg: e.message }));
        }
        setStatus('');
      }
    }

    load();
  </script>
</CompanionLayout>
