---
// Today — the home screen. Answers one question first ("what needs me right
// now?"), offers a quick capture box, then shows the whole pipeline in plain
// words: thoughts → topic queue → this week's questions → waiting to publish
// → published. Read-only except quick capture (rides POST /api/spark).
import CompanionLayout from '../layouts/CompanionLayout.astro';
---

<CompanionLayout
  title="Today"
  tab="today"
  lede="What the writing pipeline needs from you — usually nothing, sometimes two minutes."
>
  <style is:global>
    .attn { display: flex; gap: 0.55rem; align-items: baseline; }
    .attn .dot { flex: 0 0 auto; width: 0.5rem; height: 0.5rem; border-radius: 999px; position: relative; top: -0.05rem; }
    .attn.now .dot { background: var(--red); }
    .attn.soon .dot { background: var(--amber); }
    .attn.later .dot { background: var(--dim); }
    .card a { color: inherit; text-decoration: none; display: block; }
    .card .title { color: var(--text); font-weight: 600; font-size: 0.93rem; }
    #quick { display: flex; gap: 0.5rem; margin-bottom: 1.4rem; }
    #quick input { flex: 1; min-width: 0; }
    #quick button { flex: 0 0 auto; }
    #empty-now { color: var(--green); font-size: 0.9rem; margin-bottom: 0.55rem; }
    #how { margin-top: 0.5rem; }
    #how summary { cursor: pointer; font-size: 0.8rem; color: var(--dim); }
    #how p { font-size: 0.82rem; color: var(--muted); padding-top: 0.5rem; }
  </style>

  <main id="board" hidden>
    <section class="stage" id="now">
      <h2>Up to you</h2>
      <div id="now-list"></div>
    </section>

    <div id="quick">
      <input id="quick-text" enterkeyhint="send" placeholder="Save a quick thought…" />
      <button id="quick-send" class="btn-primary">Save</button>
    </div>

    <section class="stage" id="sparks">
      <h2>Your thoughts <span class="count" id="sparks-count"></span><span class="when">picked as topics every Mon</span></h2>
      <div id="sparks-list"></div>
    </section>

    <section class="stage" id="backlog">
      <h2>Topic queue <span class="count" id="backlog-count"></span><span class="when">unused topics expire after 21 days</span></h2>
      <div id="backlog-list"></div>
    </section>

    <section class="stage" id="interview">
      <h2>This week's questions <span class="when">arrive Tue · drafts written Thu</span></h2>
      <div id="interview-list"></div>
    </section>

    <section class="stage" id="desk">
      <h2>Waiting to publish <span class="count" id="desk-count"></span><span class="when">checked every Fri</span></h2>
      <div id="desk-list"></div>
    </section>

    <section class="stage" id="published">
      <h2>Published <span class="when"><a href="/" style="color:var(--dim)">the site →</a></span></h2>
      <div id="published-list"></div>
    </section>

    <details id="how">
      <summary>How this works</summary>
      <p>You do two small things: save thoughts (any tab, any time) and answer the
        week's questions in your own words. The pipeline does the rest on a weekly
        rhythm — Monday it picks topics from your thoughts, Tuesday it asks you
        questions, Thursday it writes bilingual drafts from your answers, Friday it
        checks them. You publish with one tap on the Publish tab.</p>
    </details>
  </main>

  <p class="hint">Thoughts → topics → questions → drafts → published · the pipeline runs the belt, you supply the point of view</p>

  <script is:inline>
    const { $, api, el, getToken, setStatus, needToken, localDate, flowData, applyBadges } = QN;

    function card(className) { return el('div', 'card' + (className ? ' ' + className : '')); }

    function render(flow) {
      // Up to you
      const now = $('now-list');
      now.replaceChildren();
      if (!flow.needsYou.length) {
        now.appendChild(el('p', '', 'Nothing needs you right now — the pipeline is running on its own.')).id = 'empty-now';
      }
      for (const item of flow.needsYou) {
        const c = card();
        const row = el('div', 'attn ' + item.urgency);
        row.appendChild(el('span', 'dot'));
        const a = el('a', '', item.text);
        a.href = item.href;
        row.appendChild(a);
        c.appendChild(row);
        now.appendChild(c);
      }

      // Your thoughts
      $('sparks-count').textContent = flow.sparks.unconsumed + ' waiting';
      const sparks = $('sparks-list');
      sparks.replaceChildren();
      if (!flow.sparks.recent.length) {
        sparks.appendChild(card('dim')).textContent = 'No thoughts saved yet — the box above takes one line.';
      }
      for (const s of flow.sparks.recent) {
        const c = card(s.consumed ? 'dim' : '');
        c.appendChild(el('div', '', s.text));
        c.appendChild(el('div', 'sub', s.date + (s.consumed ? ' · became a topic' : ' · waiting to be picked')));
        sparks.appendChild(c);
      }

      // Topic queue
      $('backlog-count').textContent = flow.backlog.live.length + ' live';
      const backlog = $('backlog-list');
      backlog.replaceChildren();
      if (!flow.backlog.live.length) {
        backlog.appendChild(card('dim')).textContent = 'No topics queued — Monday’s pick fills this from your thoughts.';
      }
      for (const b of flow.backlog.live) {
        const c = card();
        c.appendChild(el('div', 'title', b.title));
        if (b.thesis) c.appendChild(el('div', 'sub', b.thesis));
        const chips = el('div', 'sub');
        chips.appendChild(el('span', 'chip' + (b.expiresInDays <= 5 ? ' warn' : ''), 'expires in ' + Math.max(b.expiresInDays, 0) + 'd'));
        if (b.draftability) chips.appendChild(el('span', 'chip', 'draftability ' + b.draftability.toLowerCase()));
        c.appendChild(chips);
        backlog.appendChild(c);
      }
      if (flow.backlog.draftedCount || flow.backlog.expiredCount) {
        backlog.appendChild(card('dim')).textContent =
          flow.backlog.draftedCount + ' drafted · ' + flow.backlog.expiredCount + ' expired (the queue decays by design)';
      }

      // This week's questions
      const interview = $('interview-list');
      interview.replaceChildren();
      if (flow.interview) {
        const c = card();
        const a = el('a');
        a.href = '/interview/';
        a.appendChild(el('div', 'title', flow.interview.title));
        const done = flow.interview.answered >= flow.interview.total && flow.interview.total > 0;
        a.appendChild(el('div', 'sub', flow.interview.answered + ' of ' + flow.interview.total + ' answered — ' +
          (done ? 'ready for Thursday’s draft ✓' : 'dictate a few on a walk →')));
        c.appendChild(a);
        if (done) c.querySelector('.sub').prepend(el('span', 'chip ok', 'answered'));
        interview.appendChild(c);
      } else {
        interview.appendChild(card('dim')).textContent = 'No questions this week yet — they arrive Tuesday when there’s a live topic.';
      }

      // Waiting to publish
      $('desk-count').textContent = flow.desk.length + ' draft' + (flow.desk.length === 1 ? '' : 's');
      const desk = $('desk-list');
      desk.replaceChildren();
      for (const pr of flow.desk) {
        const c = card();
        const a = el('a');
        a.href = '/desk/';
        a.appendChild(el('div', 'title', '#' + pr.number + ' ' + pr.title));
        const chips = el('div', 'sub');
        if (pr.tier) chips.appendChild(el('span', 'chip', pr.tier));
        chips.appendChild(el('span', 'chip' + (pr.ageDays >= 5 ? ' warn' : ''), pr.ageDays + 'd waiting'));
        chips.appendChild(el('span', 'chip' + (pr.verdict === 'ready' ? ' ok' : pr.verdict === 'attention' ? ' warn' : ''),
          pr.verdict === 'ready' ? 'ready to publish' : pr.verdict === 'attention' ? 'needs your call' : 'not checked yet'));
        a.appendChild(chips);
        c.appendChild(a);
        desk.appendChild(c);
      }
      if (!flow.desk.length) desk.appendChild(card('dim')).textContent = 'No drafts waiting — new ones are written Thursday.';

      // Published
      const published = $('published-list');
      published.replaceChildren();
      for (const p of flow.published) {
        const c = card('dim');
        c.appendChild(el('div', '', p.summary));
        c.appendChild(el('div', 'sub', p.date));
        published.appendChild(c);
      }
      if (!flow.published.length) published.appendChild(card('dim')).textContent = 'Recently published pieces show up here.';

      $('board').hidden = false;
    }

    async function load() {
      if (!getToken()) { needToken(); return; }
      setStatus('loading…');
      try {
        const flow = await flowData(true); // home always shows fresh state
        render(flow);
        applyBadges(flow);
        setStatus('');
      } catch (e) {
        setStatus(e.unauthorized || e.config ? '' : e.message);
      }
    }

    async function quickSend() {
      const input = $('quick-text');
      const text = input.value.trim();
      if (!text) return;
      $('quick-send').disabled = true;
      setStatus('saving…');
      try {
        await api('/api/spark', { text, date: localDate() });
        input.value = '';
        setStatus('✓ saved to your thoughts');
        load();
      } catch (e) {
        if (!e.unauthorized && !e.config) setStatus(e.message);
        else setStatus('');
      } finally {
        $('quick-send').disabled = false;
      }
    }
    $('quick-send').addEventListener('click', quickSend);
    $('quick-text').addEventListener('keydown', (e) => { if (e.key === 'Enter') quickSend(); });

    load();
  </script>
</CompanionLayout>
