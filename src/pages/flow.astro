---
// Today — the home screen. Answers one question first ("what needs me right
// now?"), offers a quick capture box, shows the whole pipeline as a belt
// (thoughts → topics → questions → draft → published) from real /api/flow
// counts, then the same stages as tappable folds for the detail and actions.
// Read-only except quick capture (rides POST /api/spark).
import CompanionLayout from '../layouts/CompanionLayout.astro';
---

<CompanionLayout
  title="Today"
  titleKey="today.title"
  tab="today"
  lede="What the writing pipeline needs from you — usually nothing, sometimes two minutes."
  ledeKey="today.lede"
>
  <style is:global>
    /* Up to you — a colored urgency dot, a bold headline, a muted detail. */
    .attn { display: flex; gap: 0.6rem; align-items: flex-start; }
    .attn .dot { flex: 0 0 auto; width: 0.5rem; height: 0.5rem; border-radius: 999px; margin-top: 0.42rem; }
    .attn.now .dot { background: var(--red); }
    .attn.soon .dot { background: var(--amber); }
    .attn.later .dot { background: var(--faint); }
    .attn .body { min-width: 0; }
    .attn .a-title { color: var(--ink); font-weight: 600; font-size: 0.93rem; line-height: 1.35; }
    .attn .a-detail { color: var(--muted); font-size: 0.85rem; margin-top: 0.15rem; line-height: 1.42; }
    .card a { color: inherit; text-decoration: none; display: block; }
    .card .title { color: var(--ink); font-weight: 600; font-size: 0.93rem; }
    #quick { display: flex; gap: 0.5rem; margin-bottom: 1.7rem; }
    #quick input { flex: 1; min-width: 0; }
    #quick button { flex: 0 0 auto; }
    #empty-now { color: var(--accent); font-size: 0.9rem; margin-bottom: 0.55rem; }

    /* The belt — the whole pipeline at a glance, active stages in accent. */
    .belt-label { font-family: var(--mono); font-size: 0.66rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 0.6rem; }
    .belt { display: flex; align-items: flex-start; justify-content: space-between; background: var(--card); border: 1px solid var(--line); border-radius: 0.85rem; padding: 1rem 0.6rem; margin-bottom: 0.85rem; }
    .belt .node { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; flex: 1 1 0; text-decoration: none; }
    .belt .num { font-family: var(--serif); font-size: 1.35rem; line-height: 1; color: var(--ink); }
    .belt .lbl { font-family: var(--mono); font-size: 0.56rem; line-height: 1.2; letter-spacing: 0.02em; color: var(--muted); text-align: center; }
    .belt .node.active .num, .belt .node.active .lbl { color: var(--accent); }
    .belt .arrow { color: var(--faint); margin-top: 0.4rem; font-size: 0.85rem; flex: 0 0 auto; }
    .schedule { font-family: var(--mono); font-size: 0.68rem; color: var(--faint); text-align: center; margin-bottom: 1.7rem; line-height: 1.6; }

    /* Topic cards keep their take / pass actions. */
    .topic-actions { display: flex; gap: 0.4rem; margin-top: 0.6rem; }
    .topic-actions button {
      font-size: 0.78rem; font-weight: 600; color: var(--body);
      background: transparent; border: 1px solid var(--line);
      border-radius: 0.5rem; padding: 0.4rem 0.75rem; min-height: 2.1rem;
    }
    .topic-actions .pass { color: var(--red); }
    .take {
      font-family: var(--serif); font-style: italic; font-size: 0.9rem; color: var(--body);
      background: var(--card2); border: 1px solid var(--line); border-left: 2px solid var(--accent);
      border-radius: 0.5rem; padding: 0.5rem 0.65rem; margin-top: 0.5rem; margin-bottom: 0.35rem;
    }
    .take .sub { font-family: var(--sans); font-style: normal; }
    .take-panel { margin-top: 0.55rem; }
    .take-panel textarea { min-height: 3.5rem; }
    .take-panel .row { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem; }
    #how { border-top: 1px solid var(--line); margin-top: 0.6rem; padding-top: 0.8rem; }
    #how summary { cursor: pointer; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); }
    #how p { font-size: 0.85rem; color: var(--muted); padding-top: 0.6rem; line-height: 1.55; }
  </style>

  <main id="board" hidden>
    <section class="stage" id="now">
      <h2 data-i18n="today.now">Up to you</h2>
      <div id="now-list"></div>
    </section>

    <div id="quick">
      <input id="quick-text" enterkeyhint="send" placeholder="Save a quick thought…" data-i18n-ph="today.quickPlaceholder" />
      <button id="quick-send" class="btn-primary" data-i18n="today.quickSave">Save</button>
    </div>

    <div class="belt-label" data-i18n="today.belt">The belt</div>
    <div class="belt" id="belt"></div>
    <p class="schedule" id="schedule" data-i18n="today.schedule"></p>

    <details class="stage-fold" id="fold-sparks">
      <summary><span data-i18n="today.foldSparks">Your thoughts</span> <span class="count" id="sparks-count"></span><span class="when" data-i18n="today.whenSparks">picked Mon</span></summary>
      <div class="fold-body"><div id="sparks-list"></div></div>
    </details>

    <details class="stage-fold" id="fold-backlog">
      <summary><span data-i18n="today.foldBacklog">Topic queue</span> <span class="count" id="backlog-count"></span><span class="when" data-i18n="today.whenBacklog">expire in 21d</span></summary>
      <div class="fold-body"><div id="backlog-list"></div></div>
    </details>

    <details class="stage-fold" id="fold-interview">
      <summary><span data-i18n="today.foldInterview">This week's questions</span> <span class="count" id="interview-count"></span><span class="when" data-i18n="today.whenInterview">answer by Thu</span></summary>
      <div class="fold-body"><div id="interview-list"></div></div>
    </details>

    <details class="stage-fold" id="fold-desk">
      <summary><span data-i18n="today.foldDesk">Waiting to publish</span> <span class="count" id="desk-count"></span><span class="when" data-i18n="today.whenDesk">checked Fri</span></summary>
      <div class="fold-body"><div id="desk-list"></div></div>
    </details>

    <details class="stage-fold" id="fold-published">
      <summary><span data-i18n="today.foldPublished">Published</span> <span class="when"><a href="/" style="color:var(--faint)" data-i18n="today.siteLink">the site →</a></span></summary>
      <div class="fold-body"><div id="published-list"></div></div>
    </details>

    <details id="how">
      <summary data-i18n="today.howSummary">How this works</summary>
      <p data-i18n="today.howBody">Save thoughts any time, steer the topic queue, and answer the week's questions in
        your own words. The pipeline runs the rest on a weekly rhythm: picks topics Mon,
        writes questions Tue, drafts Thu, checks Fri. You publish with one tap.</p>
    </details>
  </main>

  <p class="hint" data-i18n="today.hint">Thoughts → topics → questions → drafts → published · the pipeline runs the belt, you supply the point of view</p>

  <script is:inline>
    const { $, api, el, getToken, setStatus, setMeta, needToken, localDate, flowData, applyBadges, refreshBadges, attachDictation, t } = QN;

    function card(className) { return el('div', 'card' + (className ? ' ' + className : '')); }

    // A take the author saved on this topic, shown back on its card so a
    // refresh proves it stuck (it lives as a spark in the inbox).
    function takeLine(text, sub) {
      const node = el('div', 'take', '“' + text + '”');
      node.appendChild(el('div', 'sub', t('today.yourTake', { sub })));
      return node;
    }

    // The two things you can do with a queued topic: put your thinking on it
    // (a spark — author input outranks scouted topics, so it steers Tuesday's
    // pick) or pass (marks it rejected so it stops counting down).
    function topicActions(b, c, chips) {
      const frag = document.createDocumentFragment();
      const actions = el('div', 'topic-actions');
      const panel = el('div', 'take-panel');
      panel.hidden = true;

      const take = el('button', '', t('today.addTake'));
      take.addEventListener('click', () => {
        panel.hidden = !panel.hidden;
        if (!panel.hidden) ta.focus();
      });

      const ta = el('textarea');
      ta.placeholder = t('today.takePlaceholder');
      ta.enterKeyHint = 'send';
      const row = el('div', 'row');
      const dict = attachDictation(ta);
      if (dict) row.append(dict.mic, dict.lang);
      const save = el('button', 'btn-primary', t('today.saveTake'));
      save.addEventListener('click', async () => {
        const text = ta.value.trim();
        if (!text) return;
        save.disabled = true;
        try {
          await api('/api/spark', { text: 'On “' + b.title + '”: ' + text, date: localDate() });
          // Show the take on the card right away — the same place it will
          // reappear from the server on the next load.
          chips.before(takeLine(text, t('today.savedTick')));
          ta.value = '';
          panel.hidden = true;
          setStatus(t('today.savedToThoughts'));
          refreshBadges(true);
        } catch (e) {
          if (!e.unauthorized && !e.config) setStatus(e.message);
        } finally {
          save.disabled = false;
        }
      });
      row.appendChild(save);
      panel.append(ta, row);

      const pass = el('button', 'pass', t('today.pass'));
      pass.addEventListener('click', async () => {
        if (!confirm(t('today.confirmPass', { title: b.title }))) return;
        pass.disabled = true;
        try {
          await api('/api/backlog/pass', { date: b.date, title: b.title });
          c.classList.add('dim');
          actions.remove();
          panel.remove();
          chips.replaceChildren(el('span', 'chip', t('today.passedTick')));
          refreshBadges(true);
        } catch (e) {
          pass.disabled = false;
          if (!e.unauthorized && !e.config) setStatus(e.message);
        }
      });

      actions.append(take, pass);
      frag.append(actions, panel);
      return frag;
    }

    // The belt — one node per pipeline stage, active stages (something waiting
    // on you) drawn in accent. Nodes deep-link to their fold below.
    function renderBelt(flow) {
      const belt = $('belt');
      belt.replaceChildren();
      const interviewLeft = flow.interview
        ? Math.max(flow.interview.total - flow.interview.answered, 0)
        : 0;
      const nodes = [
        { n: flow.sparks.unconsumed, label: t('today.beltThoughts'), href: '#fold-sparks' },
        { n: flow.backlog.live.length, label: t('today.beltTopics'), href: '#fold-backlog' },
        {
          n: flow.interview ? flow.interview.total : 0,
          label: t('today.beltQuestions'),
          href: '#fold-interview',
          active: !!(flow.interview && !flow.interview.ready && interviewLeft > 0),
        },
        { n: flow.desk.length, label: t('today.beltDraft'), href: '#fold-desk', active: flow.desk.length > 0 },
        {
          n: flow.publishedTotal != null ? flow.publishedTotal : flow.published.length,
          label: t('today.beltPublished'),
          href: '#fold-published',
        },
      ];
      nodes.forEach((node, i) => {
        const a = el('a', 'node' + (node.active ? ' active' : ''));
        a.href = node.href;
        a.appendChild(el('span', 'num', String(node.n)));
        a.appendChild(el('span', 'lbl', node.label));
        belt.appendChild(a);
        if (i < nodes.length - 1) belt.appendChild(el('span', 'arrow', '→'));
      });
    }

    function render(flow) {
      // Up to you
      const now = $('now-list');
      now.replaceChildren();
      if (!flow.needsYou.length) {
        now.appendChild(el('p', '', t('today.nothingNeeds'))).id = 'empty-now';
      }
      for (const item of flow.needsYou) {
        const c = card();
        const a = el('a', '');
        a.href = item.href;
        const row = el('div', 'attn ' + item.urgency);
        row.appendChild(el('span', 'dot'));
        const bodyEl = el('div', 'body');
        // The needs-you text reads "<headline> — <detail>"; split it so the
        // card leads with the headline and softens the rest, per the design.
        const dash = item.text.indexOf(' — ');
        if (dash > 0) {
          bodyEl.appendChild(el('div', 'a-title', item.text.slice(0, dash)));
          bodyEl.appendChild(el('div', 'a-detail', item.text.slice(dash + 3)));
        } else {
          bodyEl.appendChild(el('div', 'a-title', item.text));
        }
        row.appendChild(bodyEl);
        a.appendChild(row);
        c.appendChild(a);
        now.appendChild(c);
      }

      renderBelt(flow);

      // Your thoughts
      $('sparks-count').textContent = t('today.nWaiting', { n: flow.sparks.unconsumed });
      const sparks = $('sparks-list');
      sparks.replaceChildren();
      if (!flow.sparks.recent.length) {
        sparks.appendChild(card('dim')).textContent = t('today.noThoughts');
      }
      for (const s of flow.sparks.recent) {
        const c = card(s.consumed ? 'dim' : '');
        c.appendChild(el('div', '', s.text));
        c.appendChild(el('div', 'sub', s.date + t(s.consumed ? 'today.becameTopic' : 'today.waitingPicked')));
        sparks.appendChild(c);
      }

      // Topic queue
      $('backlog-count').textContent = t('today.nLive', { n: flow.backlog.live.length });
      const backlog = $('backlog-list');
      backlog.replaceChildren();
      if (!flow.backlog.live.length) {
        backlog.appendChild(card('dim')).textContent = t('today.noTopics');
      }
      for (const b of flow.backlog.live) {
        const c = card();
        c.appendChild(el('div', 'title', b.title));
        if (b.thesis) c.appendChild(el('div', 'sub', b.thesis));
        for (const take of b.takes || []) {
          c.appendChild(takeLine(take.text, take.date));
        }
        const chips = el('div', 'sub');
        chips.appendChild(el('span', 'chip' + (b.expiresInDays <= 5 ? ' warn' : ''), t('today.expiresIn', { n: Math.max(b.expiresInDays, 0) })));
        if (b.draftability) chips.appendChild(el('span', 'chip', t('today.draftability', { v: b.draftability.toLowerCase() })));
        c.appendChild(chips);
        c.appendChild(topicActions(b, c, chips));
        backlog.appendChild(c);
      }
      const decayed = [];
      if (flow.backlog.draftedCount) decayed.push(t('today.nDrafted', { n: flow.backlog.draftedCount }));
      if (flow.backlog.expiredCount) decayed.push(t('today.nExpired', { n: flow.backlog.expiredCount }));
      if (flow.backlog.passedCount) decayed.push(t('today.nPassed', { n: flow.backlog.passedCount }));
      if (decayed.length) {
        backlog.appendChild(card('dim')).textContent = t('today.queueDecays', { list: decayed.join(' · ') });
      }

      // This week's questions — the fold opens itself while any remain unanswered.
      const interview = $('interview-list');
      interview.replaceChildren();
      if (flow.interview) {
        const done = flow.interview.answered >= flow.interview.total && flow.interview.total > 0;
        const left = Math.max(flow.interview.total - flow.interview.answered, 0);
        $('interview-count').textContent = done ? t('today.answered') : t('today.nLeft', { n: left });
        $('fold-interview').open = !done;
        const c = card();
        const a = el('a');
        a.href = '/interview/';
        a.appendChild(el('div', 'title', flow.interview.title));
        a.appendChild(el('div', 'sub', t('answer.progress', {
          done: flow.interview.answered, total: flow.interview.total,
          tail: t(done ? 'today.readyThu' : 'today.dictateWalk'),
        })));
        c.appendChild(a);
        if (done) c.querySelector('.sub').prepend(el('span', 'chip ok', t('today.answered')));
        interview.appendChild(c);
      } else {
        $('interview-count').textContent = '';
        interview.appendChild(card('dim')).textContent = t('today.noQuestions');
      }

      // Waiting to publish — opens itself when a draft is actually waiting.
      $('desk-count').textContent = t(flow.desk.length === 1 ? 'today.deskCountOne' : 'today.deskCountMany', { n: flow.desk.length });
      $('fold-desk').open = flow.desk.length > 0;
      const desk = $('desk-list');
      desk.replaceChildren();
      for (const pr of flow.desk) {
        const c = card();
        const a = el('a');
        a.href = '/desk/';
        a.appendChild(el('div', 'title', '#' + pr.number + ' ' + pr.title));
        const chips = el('div', 'sub');
        if (pr.tier) chips.appendChild(el('span', 'chip', pr.tier));
        chips.appendChild(el('span', 'chip' + (pr.ageDays >= 5 ? ' warn' : ''), t('today.ndWaiting', { n: pr.ageDays })));
        chips.appendChild(el('span', 'chip' + (pr.verdict === 'ready' ? ' ok' : pr.verdict === 'attention' ? ' warn' : ''),
          pr.verdict === 'ready' ? t('today.readyToPublish') : pr.verdict === 'attention' ? t('today.needsCall') : t('today.notChecked')));
        a.appendChild(chips);
        c.appendChild(a);
        desk.appendChild(c);
      }
      if (!flow.desk.length) desk.appendChild(card('dim')).textContent = t('today.noDrafts');

      // Published
      const published = $('published-list');
      published.replaceChildren();
      for (const p of flow.published) {
        const c = card('dim');
        c.appendChild(el('div', '', p.summary));
        c.appendChild(el('div', 'sub', p.date));
        published.appendChild(c);
      }
      if (!flow.published.length) published.appendChild(card('dim')).textContent = t('today.publishedEmpty');

      $('board').hidden = false;
    }

    // A friendly "Tue · Jul 22" in the header corner, like the design.
    function showDate() {
      const d = new Date();
      const wd = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][d.getDay()];
      const mo = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][d.getMonth()];
      setMeta(wd + ' · ' + mo + ' ' + d.getDate());
    }

    // "Up to you" cards deep-link to a fold (e.g. #fold-backlog from /api/flow).
    // A collapsed <details> swallows the jump, so open the target and scroll to it.
    function revealFromHash() {
      const target = location.hash && document.getElementById(location.hash.slice(1));
      if (target && target.tagName === 'DETAILS') {
        target.open = true;
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    window.addEventListener('hashchange', revealFromHash);

    async function load() {
      showDate();
      if (!getToken()) { needToken(); return; }
      setStatus(t('today.loading'));
      try {
        const flow = await flowData(true); // home always shows fresh state
        render(flow);
        applyBadges(flow);
        setStatus('');
        revealFromHash(); // honor a deep link once the folds exist
      } catch (e) {
        setStatus(e.unauthorized || e.config ? '' : e.message);
      }
    }

    async function quickSend() {
      const input = $('quick-text');
      const text = input.value.trim();
      if (!text) return;
      $('quick-send').disabled = true;
      setStatus(t('capture.saving'));
      try {
        await api('/api/spark', { text, date: localDate() });
        input.value = '';
        setStatus(t('today.savedToThoughts'));
        load();
      } catch (e) {
        if (!e.unauthorized && !e.config) setStatus(e.message);
        else setStatus('');
      } finally {
        $('quick-send').disabled = false;
      }
    }
    $('quick-send').addEventListener('click', quickSend);
    $('quick-text').addEventListener('keydown', (e) => { if (e.key === 'Enter') quickSend(); });

    load();
  </script>
</CompanionLayout>
