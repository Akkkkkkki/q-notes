---
// Answer — "answer five questions on a commute" (vision §3.2).
// The week's brief from research/interviews/ rendered as a conversation:
// the idea on top, one question per card, dictation on every card. Each
// answer commits immediately into the file's ## Author answers section.
import CompanionLayout from '../layouts/CompanionLayout.astro';
---

<CompanionLayout
  title="Answer"
  titleKey="answer.title"
  tab="answer"
  lede="This week's questions — talk or type in your own words. Fragments are fine."
  ledeKey="answer.lede"
>
  <style is:global>
    #idea {
      font-size: 0.92rem;
      color: var(--body);
      background: #131313;
      border: 1px solid #242424;
      border-radius: var(--radius);
      padding: 0.8rem 0.9rem;
      margin-bottom: 0.6rem;
    }
    #progress { font-size: 0.8rem; color: var(--muted); margin-bottom: 1.1rem; }
    #title { font-size: 1.05rem; font-weight: 650; letter-spacing: -0.01em; margin: 0.25rem 0 0.5rem; }
    .q-card h2 { font-size: 0.95rem; font-weight: 600; color: var(--text); margin-bottom: 0.6rem; }
    .q-card h2 .qn { color: var(--muted); font-weight: 500; margin-right: 0.4rem; }
    .q-card textarea { min-height: 5.5rem; background: var(--surface-2); }
    .q-card .row { display: flex; gap: 0.5rem; margin-top: 0.6rem; align-items: center; }
    .q-card .row .state { flex: 1; }
    .q-card.answered { border-color: #2e4633; }
    footer { margin-top: 1.5rem; display: flex; gap: 0.6rem; flex-wrap: wrap; }
  </style>

  <main id="main" hidden>
    <h1 id="title"></h1>
    <div id="idea"></div>
    <p id="progress"></p>
    <div id="cards"></div>
    <footer>
      <button id="notify" class="btn-ghost" hidden data-i18n="answer.notify">Notify me when questions arrive</button>
      <button id="decline" class="btn-ghost btn-danger" data-i18n="answer.decline">Not this topic — skip this week</button>
    </footer>
  </main>

  <p id="empty" class="card dim" hidden></p>

  <p class="hint" data-i18n="answer.hint">Skip any question · Thursday's draft uses whatever exists</p>

  <script is:inline>
    const { $, api, el, getToken, setStatus, needToken, attachDictation, refreshBadges, t } = QN;

    let brief = null;

    function showEmpty(msg) {
      $('empty').textContent = msg;
      $('empty').hidden = false;
      $('main').hidden = true;
    }

    function renderProgress() {
      const done = brief.questions.filter((q) => q.answer).length;
      const total = brief.questions.length;
      $('progress').textContent = t('answer.progress', {
        done, total,
        tail: t(done === total ? 'answer.progressAllSet' : 'answer.progressSome'),
      });
    }

    function render() {
      if (!brief) {
        showEmpty(t('answer.emptyNone'));
        return;
      }
      if (brief.closed) {
        showEmpty(t('answer.emptyClosed', { status: brief.status }));
        return;
      }
      $('main').hidden = false;
      $('empty').hidden = true;
      $('title').textContent = brief.title;
      $('idea').textContent = brief.idea;
      renderProgress();

      const cards = $('cards');
      cards.replaceChildren();
      for (const q of brief.questions) {
        const card = el('section', 'card q-card' + (q.answer ? ' answered' : ''));
        const h = el('h2');
        h.appendChild(el('span', 'qn', 'Q' + q.n));
        h.appendChild(document.createTextNode(q.text));
        const ta = el('textarea');
        ta.placeholder = t('answer.cardPlaceholder');
        ta.value = q.answer || '';
        ta.enterKeyHint = 'done';
        const row = el('div', 'row');
        const save = el('button', 'btn-primary', q.answer ? t('answer.update') : t('answer.save'));
        const state = el('span', 'state');
        if (q.answer) state.textContent = t('answer.savedTick');
        save.addEventListener('click', async () => {
          const text = ta.value.trim();
          if (!text) return;
          save.disabled = true;
          state.textContent = t('answer.saving');
          try {
            await api('/api/answer', { path: brief.path, question: q.n, text });
            q.answer = text;
            card.classList.add('answered');
            save.textContent = t('answer.update');
            state.textContent = t('answer.savedTick');
            renderProgress();
            refreshBadges(true);
          } catch (e) {
            state.textContent = e.unauthorized ? t('answer.connectFirst') : t('answer.didntSave');
          } finally {
            save.disabled = false;
          }
        });
        row.appendChild(save);
        const dict = attachDictation(ta, (on) => { state.textContent = on ? t('answer.listening') : state.textContent === t('answer.listening') ? '' : state.textContent; });
        if (dict) row.append(dict.lang, dict.mic);
        row.appendChild(state);
        card.append(h, ta, row);
        cards.appendChild(card);
      }
    }

    $('decline').addEventListener('click', async () => {
      if (!brief) return;
      if (!confirm(t('answer.confirmDecline'))) return;
      setStatus(t('answer.closing'));
      try {
        await api('/api/brief/close', { path: brief.path });
        brief.closed = true;
        brief.status = 'Closed (not this topic)';
        setStatus('');
        render();
        refreshBadges(true);
      } catch (e) {
        setStatus(e.unauthorized ? '' : t('answer.didntClose'));
      }
    });

    // Web push for the Tuesday questions: offered only where supported and configured.
    async function setupNotifyButton() {
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
      const reg = await navigator.serviceWorker.ready;
      const existing = await reg.pushManager.getSubscription();
      if (existing) return;
      const btn = $('notify');
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try {
          const { key } = await api('/api/push/key');
          const sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: Uint8Array.from(
              atob(key.replace(/-/g, '+').replace(/_/g, '/')),
              (c) => c.charCodeAt(0)
            ),
          });
          await api('/api/push/subscribe', sub.toJSON());
          btn.textContent = t('answer.notifyOn');
        } catch (e) {
          btn.textContent = t('answer.notifyUnavailable');
        }
      });
    }

    async function load() {
      if (!getToken()) {
        needToken();
        showEmpty(t('answer.connectToLoad'));
        return;
      }
      setStatus(t('answer.loading'));
      try {
        brief = (await api('/api/brief')).brief;
        setStatus('');
        render();
        setupNotifyButton();
      } catch (e) {
        if (e.unauthorized) {
          showEmpty(t('answer.connectToLoad'));
        } else if (e.config) {
          showEmpty(t('answer.cantLoadServer'));
        } else {
          showEmpty(t('answer.cantLoad', { msg: e.message }));
        }
        setStatus('');
      }
    }

    load();
  </script>
</CompanionLayout>
