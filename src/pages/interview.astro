---
// Answer — "answer five questions on a commute" (vision §3.2).
// The week's brief from research/interviews/ as a focused conversation: the
// idea and a progress bar on top, then one question at a time. Optional answer
// directions stay hidden until the author asks for a nudge, so an independent
// answer gets first shot. Each saved answer records whether it began free or
// after a nudge, while mic / partial-answer / Ready-reopen behavior stays intact.
import CompanionLayout from '../layouts/CompanionLayout.astro';
---

<CompanionLayout
  title="Answer"
  titleKey="answer.title"
  tab="answer"
  lede="Talk or tap in your own words. This is where a thought gets stress-tested."
  ledeKey="answer.lede"
>
  <style is:global>
    .topic-card { background: var(--card); border: 1px solid var(--line); border-radius: 0.85rem; padding: 0.95rem; margin-bottom: 1.1rem; }
    .topic-label { font-family: var(--mono); font-size: 0.6rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.55rem; }
    .topic-idea { font-family: var(--serif); font-size: 1.02rem; line-height: 1.5; color: var(--ink); margin-bottom: 0.85rem; }
    .progress-bar { height: 5px; border-radius: 999px; background: var(--soft); overflow: hidden; }
    .progress-bar > span { display: block; height: 100%; width: 0; background: var(--accent); transition: width 0.3s ease; }

    .q-card { border: 1px solid var(--line); border-radius: 0.85rem; padding: 0.95rem; margin-bottom: 0.75rem; }
    .q-card.expanded { background: var(--card2); box-shadow: var(--sh); }
    .q-card.collapsed { background: var(--card); cursor: pointer; opacity: 0.72; }
    .q-card.collapsed:hover { opacity: 1; }
    .q-card.answered { border-color: var(--accent-14); }
    .q-head { display: flex; gap: 0.6rem; align-items: baseline; }
    .q-head .qn { flex: 0 0 auto; font-family: var(--mono); font-size: 0.7rem; font-weight: 600; color: var(--faint); }
    .q-card.collapsed .q-text { font-family: var(--serif); font-size: 0.95rem; line-height: 1.35; color: var(--muted); }
    .q-card.expanded .q-text { font-family: var(--serif); font-size: 1.25rem; font-weight: 500; line-height: 1.32; color: var(--ink); }
    .q-head .done { margin-left: auto; align-self: center; }
    .q-body { margin-top: 0.9rem; }

    .nudge-row { display: flex; justify-content: flex-start; margin: 0.55rem 0 0.8rem; }
    .nudge { font-size: 0.78rem; padding: 0.42rem 0.65rem; }
    .optional-hints { margin-bottom: 0.85rem; }
    .choices { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem; }
    .choice {
      font-size: 0.82rem; color: var(--body); background: transparent; text-align: left;
      border: 1px solid var(--line); border-radius: 999px; padding: 0.5rem 0.85rem; line-height: 1.3;
    }
    .choice:hover, .choice.used { border-color: var(--accent); color: var(--accent); }

    .pushback { border: 1px solid var(--line); border-left: 3px solid var(--amber); border-radius: 0.6rem; padding: 0.7rem 0.8rem; margin-bottom: 0.85rem; background: var(--card); }
    .pushback-label { font-family: var(--mono); font-size: 0.56rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--amber); margin-bottom: 0.55rem; }
    .p-item { display: block; width: 100%; text-align: left; font-size: 0.82rem; color: var(--body); background: var(--card2); border: 1px solid var(--line); border-radius: 0.5rem; padding: 0.55rem 0.65rem; line-height: 1.35; }
    .p-item + .p-item { margin-top: 0.5rem; }
    .p-item:hover { border-color: var(--amber); }

    .reading { display: flex; gap: 0.65rem; align-items: flex-start; border: 1px solid var(--line); border-radius: 0.6rem; padding: 0.7rem 0.8rem; margin-bottom: 0.85rem; text-decoration: none; }
    .reading:hover { border-color: var(--accent); text-decoration: none; }
    .reading .r-ico { flex: 0 0 auto; margin-top: 0.15rem; color: var(--accent); display: inline-flex; }
    .reading .r-label { font-family: var(--mono); font-size: 0.56rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.3rem; }
    .reading .r-title { font-size: 0.85rem; line-height: 1.4; color: var(--ink); font-weight: 600; }
    .reading .r-host { font-family: var(--mono); font-size: 0.68rem; color: var(--faint); margin-top: 0.15rem; }

    .q-card textarea { min-height: 5rem; }
    .q-mic { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.55rem; }
    .q-mic .state { flex: 1; }
    .q-actions { display: flex; gap: 0.6rem; margin-top: 0.7rem; }
    .q-actions .skip { flex: 1; }
    .q-actions .save { flex: 2; }

    #ready-banner {
      font-size: 0.86rem; color: var(--accent); background: var(--accent-08);
      border: 1px solid var(--accent-14); border-radius: 0.7rem; padding: 0.75rem 0.85rem; margin-bottom: 0.85rem;
    }
    footer { margin-top: 1.6rem; border-top: 1px solid var(--line); padding-top: 1.1rem; display: flex; flex-direction: column; gap: 0.7rem; text-align: center; }
    .ready-caption { font-size: 0.78rem; color: var(--faint); margin: 0; line-height: 1.5; }
    footer .footer-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; justify-content: center; }
  </style>

  <main id="main" hidden>
    <div class="topic-card">
      <div class="topic-label" data-i18n="answer.topicLabel">This week's topic</div>
      <div class="topic-idea" id="idea"></div>
      <div class="progress-bar"><span id="progress-fill"></span></div>
    </div>
    <div id="ready-banner" hidden></div>
    <div id="cards"></div>
    <footer>
      <p class="ready-caption" id="ready-caption" data-i18n="answer.readyCaption"></p>
      <button id="ready" class="btn-soft btn-block" data-i18n="answer.markReady">Ready to draft →</button>
      <div class="footer-actions">
        <button id="notify" class="btn-ghost" hidden data-i18n="answer.notify">Notify me when questions arrive</button>
        <button id="decline" class="btn-ghost btn-danger" data-i18n="answer.decline">Not this topic — skip this week</button>
      </div>
    </footer>
  </main>

  <p id="empty" class="card dim" hidden></p>

  <p class="hint" data-i18n="answer.hint">Skip any question · Thursday's draft uses whatever exists</p>

  <script is:inline>
    const { $, api, el, getToken, getUiLang, setStatus, setMeta, needToken, attachDictation, refreshBadges, t } = QN;

    const LINK_ICON = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>';

    let brief = null;
    let controllers = [];

    function showEmpty(msg) {
      $('empty').textContent = msg;
      $('empty').hidden = false;
      $('main').hidden = true;
    }

    function host(url) {
      try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; }
    }

    function seed(ta, text) {
      const cur = ta.value.trim();
      ta.value = cur ? cur + '\n' + text : text;
      ta.focus();
    }

    function updateProgress() {
      const done = brief.questions.filter((q) => q.answer).length;
      const total = brief.questions.length;
      setMeta(done + ' / ' + total + ' ' + t('today.answered'));
      $('progress-fill').style.width = (total ? (done / total) * 100 : 0) + '%';
      renderReady();
    }

    // Reflect the ready state across the footer: the banner, the button label,
    // and whether tapping it marks ready or reopens for more editing.
    function renderReady() {
      const done = brief.questions.filter((q) => q.answer).length;
      $('ready-banner').hidden = !brief.ready;
      if (brief.ready) $('ready-banner').textContent = t('answer.readyBanner');
      $('ready-caption').hidden = brief.ready;
      const btn = $('ready');
      btn.textContent = t(brief.ready ? 'answer.reopen' : 'answer.markReady');
      btn.className = (brief.ready ? 'btn-ghost' : 'btn-soft') + ' btn-block';
      btn.disabled = !brief.ready && done === 0;
    }

    function setExpanded(ctrl, on) {
      ctrl.card.classList.toggle('expanded', on);
      ctrl.card.classList.toggle('collapsed', !on);
      ctrl.body.hidden = !on;
    }
    function expand(idx, focus) {
      controllers.forEach((c, i) => setExpanded(c, i === idx));
      const ctrl = controllers[idx];
      if (ctrl) {
        ctrl.card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        if (focus) ctrl.ta.focus();
      }
    }
    // After Save / Skip, move to the next unanswered question; if none remain,
    // collapse everything so the Ready-to-draft footer is the clear next step.
    function goNext(idx) {
      let next = controllers.findIndex((c, i) => i > idx && !c.q.answer);
      if (next === -1) next = controllers.findIndex((c) => !c.q.answer);
      if (next === -1) setExpanded(controllers[idx], false);
      else expand(next);
    }

    function buildCard(q, idx) {
      const card = el('section', 'q-card' + (q.answer ? ' answered' : ''));
      const head = el('div', 'q-head');
      head.appendChild(el('span', 'qn', 'Q' + q.n));
      head.appendChild(el('div', 'q-text', q.text));
      const done = el('span', 'chip ok done', t('today.answered'));
      done.hidden = !q.answer;
      head.appendChild(done);
      card.appendChild(head);

      const body = el('div', 'q-body');

      // Independent response first. Optional interviewer directions are not in
      // the DOM flow above this box and remain hidden until an explicit nudge.
      const ta = el('textarea');
      ta.placeholder = t('answer.cardPlaceholder');
      ta.value = q.answer || '';
      ta.enterKeyHint = 'done';
      body.appendChild(ta);

      let provenance = q.provenance || 'free';
      let independentStarted = Boolean(q.answer || ta.value.trim());
      ta.addEventListener('input', () => {
        if (ta.value.trim()) independentStarted = true;
      });

      const hasHints = (q.choices && q.choices.length) || (q.pushback && q.pushback.length) || (q.reading && q.reading.length);
      if (hasHints) {
        const nudgeRow = el('div', 'nudge-row');
        const nudge = el('button', 'btn-ghost nudge', getUiLang() === 'zh' ? '需要一点提示？' : 'Need a nudge?');
        nudge.type = 'button';
        nudgeRow.appendChild(nudge);
        body.appendChild(nudgeRow);

        const hints = el('div', 'optional-hints');
        hints.hidden = true;

        // Choices — stances to react to; a tap seeds the box, then you edit or talk over it.
        if (q.choices && q.choices.length) {
          const wrap = el('div', 'choices');
          for (const text of q.choices) {
            const chip = el('button', 'choice', text);
            chip.type = 'button';
            chip.addEventListener('click', () => { seed(ta, text); chip.classList.add('used'); });
            wrap.appendChild(chip);
          }
          hints.appendChild(wrap);
        }

        // Push back — a steelman to argue against.
        if (q.pushback && q.pushback.length) {
          const box = el('div', 'pushback');
          box.appendChild(el('div', 'pushback-label', t('answer.pushLabel')));
          for (const text of q.pushback) {
            const b = el('button', 'p-item', '“' + text + '”');
            b.type = 'button';
            b.addEventListener('click', () => seed(ta, text));
            box.appendChild(b);
          }
          hints.appendChild(box);
        }

        // Worth a look — the reading direction.
        for (const r of q.reading || []) {
          const a = el(r.url ? 'a' : 'div', 'reading');
          if (r.url) { a.href = r.url; a.target = '_blank'; a.rel = 'noopener'; }
          const ico = el('span', 'r-ico');
          ico.innerHTML = LINK_ICON;
          const rb = el('div');
          rb.appendChild(el('div', 'r-label', t('answer.readLabel')));
          rb.appendChild(el('div', 'r-title', r.title));
          if (r.url) rb.appendChild(el('div', 'r-host', host(r.url)));
          a.append(ico, rb);
          hints.appendChild(a);
        }

        nudge.addEventListener('click', () => {
          // Exposure can shape a response even if no chip is tapped. Check the
          // textarea too because Web Speech updates .value without an input event.
          if (!independentStarted && !q.answer && !ta.value.trim()) provenance = 'nudge-assisted';
          hints.hidden = false;
          nudgeRow.hidden = true;
          ta.focus();
        });
        body.appendChild(hints);
      }

      const micRow = el('div', 'q-mic');
      const state = el('span', 'state');
      if (q.answer) state.textContent = t('answer.savedTick');
      const dict = attachDictation(ta, (on) => {
        state.textContent = on ? t('answer.listening') : state.textContent === t('answer.listening') ? '' : state.textContent;
      });
      if (dict) micRow.append(dict.mic, dict.lang);
      micRow.appendChild(state);
      body.appendChild(micRow);

      const actions = el('div', 'q-actions');
      const skip = el('button', 'btn-ghost skip', t('answer.skipQuestion'));
      const save = el('button', 'btn-primary save', q.answer ? t('answer.update') : t('answer.saveAnswer'));
      skip.addEventListener('click', () => goNext(idx));
      save.addEventListener('click', async () => {
        const text = ta.value.trim();
        if (!text) return;
        save.disabled = true;
        state.textContent = t('answer.saving');
        try {
          await api('/api/answer', { path: brief.path, question: q.n, text, provenance });
          q.answer = text;
          q.provenance = provenance;
          card.classList.add('answered');
          done.hidden = false;
          save.textContent = t('answer.update');
          state.textContent = t('answer.savedTick');
          updateProgress();
          refreshBadges(true);
          goNext(idx);
        } catch (e) {
          state.textContent = e.unauthorized ? t('answer.connectFirst') : t('answer.didntSave');
        } finally {
          save.disabled = false;
        }
      });
      actions.append(skip, save);
      body.appendChild(actions);

      card.appendChild(body);
      const ctrl = { card, body, ta, q };
      head.addEventListener('click', () => { if (card.classList.contains('collapsed')) expand(idx); });
      return ctrl;
    }

    function render() {
      if (!brief) { showEmpty(t('answer.emptyNone')); return; }
      if (brief.closed) { showEmpty(t('answer.emptyClosed', { status: brief.status })); return; }
      // Drafted is terminal too: the loop is closed, and offering the ready
      // toggle here would let a tap overwrite the drafter's own status line.
      if (brief.drafted) { showEmpty(t('answer.emptyDrafted', { status: brief.status })); return; }
      $('main').hidden = false;
      $('empty').hidden = true;
      $('idea').textContent = brief.idea;

      const cards = $('cards');
      cards.replaceChildren();
      controllers = brief.questions.map((q, i) => buildCard(q, i));
      for (const c of controllers) cards.appendChild(c.card);

      // Open the first unanswered question; if all are answered, keep them
      // collapsed so Ready-to-draft leads.
      let active = controllers.findIndex((c) => !c.q.answer);
      controllers.forEach((c, i) => setExpanded(c, i === active));

      updateProgress();
    }

    $('ready').addEventListener('click', async () => {
      if (!brief) return;
      const next = !brief.ready;
      const btn = $('ready');
      btn.disabled = true;
      setStatus(t(next ? 'answer.marking' : 'answer.reopening'));
      try {
        await api('/api/brief/ready', { path: brief.path, ready: next });
        brief.ready = next;
        setStatus('');
        updateProgress();
        refreshBadges(true);
      } catch (e) {
        setStatus('');
        if (e.unauthorized) { needToken(); }
        else { btn.disabled = false; alert(t('answer.readyFailed')); }
      }
    });

    $('decline').addEventListener('click', async () => {
      if (!brief) return;
      if (!confirm(t('answer.confirmDecline'))) return;
      setStatus(t('answer.closing'));
      try {
        await api('/api/brief/close', { path: brief.path });
        brief.closed = true;
        brief.status = 'Closed (not this topic)';
        setStatus('');
        render();
        refreshBadges(true);
      } catch (e) {
        setStatus(e.unauthorized ? '' : t('answer.didntClose'));
      }
    });

    // Web push for the Tuesday questions: offered only where supported and configured.
    async function setupNotifyButton() {
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
      const reg = await navigator.serviceWorker.ready;
      const existing = await reg.pushManager.getSubscription();
      if (existing) return;
      const btn = $('notify');
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try {
          const { key } = await api('/api/push/key');
          const sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: Uint8Array.from(
              atob(key.replace(/-/g, '+').replace(/_/g, '/')),
              (c) => c.charCodeAt(0)
            ),
          });
          await api('/api/push/subscribe', sub.toJSON());
          btn.textContent = t('answer.notifyOn');
        } catch (e) {
          btn.textContent = t('answer.notifyUnavailable');
        }
      });
    }

    async function load() {
      if (!getToken()) {
        needToken();
        showEmpty(t('answer.connectToLoad'));
        return;
      }
      setStatus(t('answer.loading'));
      try {
        brief = (await api('/api/brief')).brief;
        setStatus('');
        render();
        setupNotifyButton();
      } catch (e) {
        if (e.unauthorized) {
          showEmpty(t('answer.connectToLoad'));
        } else if (e.config) {
          showEmpty(t('answer.cantLoadServer'));
        } else {
          showEmpty(t('answer.cantLoad', { msg: e.message }));
        }
        setStatus('');
      }
    }

    load();
  </script>
</CompanionLayout>