---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteRow from '../../components/NoteRow.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => data.lang === 'zh')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);
const posts = allPosts.map((post) => ({ ...post, url: `/zh/posts/${post.data.translationKey}`, frontmatter: post.data }));

const stages = [
  { id: 'all', label: '全部', color: 'var(--body)' },
  { id: 'seedling', label: '萌芽', color: 'var(--gold)' },
  { id: 'growing', label: '成长', color: 'var(--accent)' },
  { id: 'evergreen', label: '常青', color: 'var(--accent)' },
];
---

<BaseLayout title="文章" lang="zh">
  <div class="wrap" style="padding:48px 26px 70px">
    <h1 style="font-family:var(--serif);font-weight:500;font-size:36px;color:var(--ink);margin:0 0 8px">文章</h1>
    <p style="font-family:var(--serif);font-style:italic;font-size:18px;color:var(--muted);margin:0 0 28px">每一篇笔记，可按成长阶段或语言筛选。</p>

    <div style="display:flex;flex-wrap:wrap;gap:16px 26px;padding-bottom:20px;margin-bottom:8px;border-bottom:1px solid var(--line)">
      <div style="display:flex;flex-direction:column;gap:8px">
        <span style="font:600 9px/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--faint)">阶段</span>
        <div id="stage-filter" style="display:flex;gap:7px">
          {stages.map((s) => (
            <button
              class="stage-chip"
              data-stage={s.id}
              data-active={s.id === 'all' ? 'true' : undefined}
              style={`font:600 11px/1 var(--mono);color:${s.color};background:transparent;border:1px solid var(--line);border-radius:6px;padding:6px 10px;cursor:pointer`}
            >{s.label}</button>
          ))}
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <span style="font:600 9px/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--faint)">语言</span>
        <div style="display:flex;gap:7px">
          <a href="/journal" style="font:500 11px/1 var(--mono);color:var(--body);border:1px solid var(--line);border-radius:6px;padding:6px 10px;text-decoration:none">EN</a>
          <span style="font:600 11px/1 var(--mono);color:var(--paper);background:var(--ink);border-radius:6px;padding:6px 10px">中文</span>
        </div>
      </div>
    </div>

    <div id="note-list">
      {posts.map((post) => (
        <div data-maturity={post.frontmatter.maturity}>
          <NoteRow post={post} titleSize={22} excerptSize={15.5} />
        </div>
      ))}
      <p id="empty-stage" hidden style="padding:28px 0;font-family:var(--serif);font-size:16px;color:var(--muted)">这个阶段还没有笔记。</p>
    </div>
  </div>

  <style>
    .stage-chip[data-active] {
      background: var(--ink) !important;
      color: var(--paper) !important;
      border-color: var(--ink) !important;
    }
  </style>

  <script>
    function initStageFilter() {
      const bar = document.getElementById('stage-filter');
      const list = document.getElementById('note-list');
      const empty = document.getElementById('empty-stage');
      if (!bar || !list) return;
      const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('.stage-chip'));
      const rows = Array.from(list.querySelectorAll<HTMLElement>('[data-maturity]'));
      const apply = (stage: string) => {
        let shown = 0;
        rows.forEach((r) => {
          const on = stage === 'all' || r.dataset.maturity === stage;
          r.hidden = !on;
          if (on) shown++;
        });
        if (empty) empty.hidden = shown !== 0;
      };
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.removeAttribute('data-active'));
          chip.setAttribute('data-active', 'true');
          apply(chip.dataset.stage || 'all');
        });
      });
    }
    initStageFilter();
    document.addEventListener('astro:page-load', initStageFilter);
  </script>
</BaseLayout>
