---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import EditorialStatusNotice from '../../../components/EditorialStatusNotice.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => data.lang === 'zh');
  return allPosts.map((entry) => ({
    params: { slug: entry.data.translationKey },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PostLayout frontmatter={entry.data}>
  <EditorialStatusNotice
    status={entry.data.editorialStatus}
    supersededBy={entry.data.supersededBy}
    archiveReason={entry.data.archiveReason}
    lang="zh"
  />
  <Content />
</PostLayout>
