---
import { getCollection, render } from 'astro:content';
import { validateEditorialCollection } from '../../../utils/editorialLifecycle';
import PostLayout from '../../../layouts/PostLayout.astro';
import EditorialStatusNotice from '../../../components/EditorialStatusNotice.astro';

export async function getStaticPaths() {
  const collection = await getCollection('posts');
  const errors = validateEditorialCollection(collection);
  if (errors.length) throw new Error(errors.join('\n'));
  const allPosts = collection.filter(({ data }) => data.lang === 'zh');
  return allPosts.map((entry) => ({
    params: { slug: entry.data.translationKey },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PostLayout frontmatter={entry.data}>
  <EditorialStatusNotice
    status={entry.data.editorialStatus}
    supersededBy={entry.data.supersededBy}
    archiveReason={entry.data.archiveReason}
    lang="zh"
  />
  <Content />
</PostLayout>
