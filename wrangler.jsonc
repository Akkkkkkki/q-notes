{
  "name": "q-notes",
  "compatibility_date": "2026-05-28",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // "/__scheduled" only exists in `wrangler dev --test-scheduled`; in
    // production it falls through to the 404 page like any unknown path.
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "vars": {
    "GITHUB_REPO": "Akkkkkkki/q-notes",
    "SPARK_TIMEZONE": "Asia/Shanghai"
  },
  // Every `wrangler deploy` — including git-triggered Workers Builds on merge
  // to main — replaces the deployed vars with the block above, silently
  // deleting any variable added in the dashboard. That is how tokens saved as
  // dashboard *Text* variables kept disappearing. keep_vars preserves them.
  // Still store the tokens as Secrets (see below) — secrets survive deploys
  // by design. Full runbook: docs/ops-runbook.md.
  "keep_vars": true,
  // Tuesday 08:30 Asia/Shanghai: nudge the phone if the week's interview
  // brief (written Tue 08:00 by routine 02) is still unanswered.
  // Friday 08:30 Asia/Shanghai: desk push if the ship gate (Fri 08:00,
  // routine 04) left open content PRs to decide on.
  "triggers": {
    "crons": ["30 0 * * 2", "30 0 * * 5"]
  }
  // Secrets (set once via `npx wrangler secret put <NAME>`):
  //   GITHUB_TOKEN      — fine-grained PAT scoped to this repo,
  //                       contents: read/write + pull requests: read/write
  //   CAPTURE_TOKEN     — shared secret for the Companion pages and shortcuts
  //   VAPID_PUBLIC_KEY,
  //   VAPID_PRIVATE_JWK — optional, web push (node scripts/generate-vapid.mjs)
}
